{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-vega",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/frontend/styles/global.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@diceui": "https://diceui.com/r/{name}.json",
    "@spectrumui": "https://ui.spectrumhq.in/r/{name}.json",
    "@efferd": "https://efferd.com/r/{name}.json",
    "@systaliko-ui": "https://systaliko-ui.vercel.app/r/{name}.json"
  }
}
