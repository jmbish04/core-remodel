---
import { cn } from "@/lib/utils";

import HeadSEO from "@/components/HeadSEO.astro";
import { Toaster } from "sonner";

/**
 * GuestLayout — the vendor portal shell (0043). Deliberately chrome-less: no
 * admin/public sidebar, no app header, no "Enter Admin Portal". Just a small
 * "126 Colby" wordmark, the page, and a one-line footer. This is the vendor's
 * whole world; it must not look like a slice of the admin tool.
 */
const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const dark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>
  </head>
  <body class={cn("overscroll-none antialiased")}>
    <div class="bg-background relative z-10 flex min-h-svh flex-col">
      <header class="border-b border-border/40">
        <div class="mx-auto flex max-w-6xl items-center px-4 py-4">
          <a href="/floor-plan" class="text-sm font-semibold tracking-tight">126 Colby</a>
        </div>
      </header>

      <main class="min-w-0 flex-1">
        <slot />
      </main>

      <footer class="border-t border-border/40">
        <div class="mx-auto max-w-6xl px-4 py-6 text-xs text-muted-foreground">
          A private preview of 126 Colby, shared by Justin.
        </div>
      </footer>

      <Toaster client:only="react" position="top-right" richColors theme="dark" />
    </div>
  </body>
</html>
