---
import { cn } from "@/lib/utils";

import HeadSEO from "@/components/HeadSEO.astro";
import { AdminSidebar } from "@/components/sidebar/AdminSidebar";
import { PublicSidebar } from "@/components/sidebar/PublicSidebar";
import { AppHeader } from "@/components/AppHeader";
import { AdminTeslaAlert } from "@/components/AdminTeslaAlert";
import { Footer } from "@/components/Footer";
import { VisitorActivityTracker } from "@/components/VisitorActivityTracker";
import { Toaster } from "sonner";

const { title, description, ogImage, collapseSidebar } = Astro.props;

// Normalize the request path so the sidebar can SSR the correct active item +
// expanded section (no trailing slash; "/" stays "/").
const currentPath = (Astro.url.pathname.replace(/\/+$/, "") || "/");

// Two-viewport split: /admin and everything under it renders the AdminSidebar
// (admin groups + Exit + Log out); every other page renders the PublicSidebar
// (public/contractor groups + Enter Admin Portal). Selected server-side from
// the normalized path so the correct sidebar is in the SSR HTML.
const isAdmin = currentPath === "/admin" || currentPath.startsWith("/admin/");

// Collapse-to-rail state, seeded from the cookie so the SSR HTML already has the
// right width (no post-hydration flash). Only meaningful on admin pages — the
// PublicSidebar has no collapse, so its content stays offset by the full width.
// `collapseSidebar` lets a page force the rail collapsed (e.g. the full-height
// inbox) WITHOUT persisting the user's cookie preference — it's per-render only.
const sidebarCollapsed =
  isAdmin &&
  (collapseSidebar === true ||
    Astro.cookies.get("remodel_sidebar_collapsed")?.value === "1");
---

<!doctype html>
<html lang="en" class="dark" data-sidebar-collapsed={sidebarCollapsed ? "1" : "0"}>
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    <style is:global>
      /* Sidebar width token: the fixed aside and the content padding both read
         it, so one client-side flip of `data-sidebar-collapsed` on <html>
         reflows the whole layout. Seeded server-side from the cookie. */
      :root { --sidebar-w: 16rem; }
      :root[data-sidebar-collapsed="1"] { --sidebar-w: 3.5rem; }
    </style>
    <script is:inline>
      (() => {
        try {
          // Enforce dark theme by default
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const dark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>
  </head>
  <body
    class={cn(
      "group/body overscroll-none antialiased [--footer-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]",
    )}
  >
    <div class="bg-background relative z-10 min-h-svh">
      {isAdmin ? (
        <AdminSidebar client:load currentPath={currentPath} collapsed={sidebarCollapsed} />
      ) : (
        <PublicSidebar client:load currentPath={currentPath} />
      )}
      <div class="flex min-h-svh w-full min-w-0 transition-[padding] duration-200 md:[padding-left:var(--sidebar-w)]">
        <div class="flex min-h-svh min-w-0 flex-1 flex-col">
          <AppHeader client:load />
          {isAdmin && <AdminTeslaAlert client:only="react" />}
          <div class="min-w-0 flex-1">
            <slot />
          </div>
          <VisitorActivityTracker client:only="react" />
          <Toaster client:only="react" position="top-right" richColors theme="dark" />
          <Footer />
        </div>
      </div>
    </div>
  </body>
</html>
