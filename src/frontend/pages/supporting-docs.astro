---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SupportingDocumentsApp } from "@/components/SupportingDocumentsApp";
---

<BaseLayout
  title="Supporting Documents - 126 Colby - Remodel Mission Control"
  description="Track foundational references, branch-specific artifacts, and revision-safe supporting documentation."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Supporting Documents</h1>
      <p class="text-muted-foreground">
        Central index for blueprints, screenshots, permits, videos, and branch-linked planning references.
      </p>
    </div>

    <SupportingDocumentsApp client:only="react" />
  </main>
</BaseLayout>
