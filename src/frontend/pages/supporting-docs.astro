---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SupportingDocumentsLibraryApp } from "@/components/SupportingDocumentsLibraryApp";
---

<BaseLayout
  title="Project Records - 126 Colby - Remodel Mission Control"
  description="Contractor-facing view of supporting documents, room records, and branching vision nodes."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Project Records</h1>
      <p class="text-muted-foreground">
        One place for contractors to review blueprints, screenshots, notes, and the active branch structure for each room.
      </p>
    </div>

    <SupportingDocumentsLibraryApp client:only="react" />
  </main>
</BaseLayout>
