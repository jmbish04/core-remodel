---
import { ProjectLogApp } from "@/components/ProjectLogApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Weekly Log - 126 Colby - Remodel Mission Control"
  description="Weekly remodel progress log with task-by-task status updates and transcripted voice memos."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Weekly Log</h1>
      <p class="text-muted-foreground">
        Compile weekly outcomes, task changes, and evidence notes in one structured report.
      </p>
    </div>

    <ProjectLogApp client:only="react" logType="weekly" />
  </main>
</BaseLayout>
