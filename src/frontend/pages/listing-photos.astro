---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Navigation } from "@/components/Navigation";
---

<BaseLayout
  title="Listing Photos - Remodel Mood Board"
  description="Manage house listing photos with AI-powered editing capabilities"
>
  <Navigation client:load />
  <main className="container mx-auto px-4 py-8">
    <div className="mb-8">
      <h1 className="text-3xl font-bold mb-2">Listing Photos</h1>
      <p className="text-muted-foreground">House stock photos with AI editing capabilities</p>
    </div>

    <div className="grid gap-6">
      <div className="rounded-lg border bg-card p-6">
        <h2 className="text-xl font-semibold mb-4">Upload Listing Photo</h2>
        <form id="upload-listing-form" className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label htmlFor="listing-file" className="block text-sm font-medium mb-2">
                Photo
              </label>
              <input
                type="file"
                id="listing-file"
                accept="image/*"
                required
                className="block w-full text-sm text-foreground file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-primary-foreground hover:file:bg-primary/90"
              />
            </div>
            <div>
              <label htmlFor="room-type" className="block text-sm font-medium mb-2">
                Room Type
              </label>
              <input
                type="text"
                id="room-type"
                required
                className="w-full rounded-md border bg-background px-3 py-2 text-sm"
                placeholder="e.g., Living Room, Kitchen"
              />
            </div>
          </div>
          <button
            type="submit"
            className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
          >
            Upload Photo
          </button>
        </form>
      </div>

      <div className="rounded-lg border bg-card p-6">
        <h2 className="text-xl font-semibold mb-4">Your Listing Photos</h2>
        <div id="listing-grid" className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <p className="col-span-full text-sm text-muted-foreground">Loading listing photos...</p>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Load listing photos
    async function loadListingPhotos() {
      try {
        const response = await fetch('/api/listing-photos');
        const data = await response.json();

        const grid = document.getElementById('listing-grid');
        if (!grid) return;

        if (!data.listingPhotos || data.listingPhotos.length === 0) {
          grid.innerHTML = '<p class="col-span-full text-sm text-muted-foreground">No listing photos yet. Upload some to get started!</p>';
          return;
        }

        grid.innerHTML = data.listingPhotos.map((photo: any) => `
          <div class="group rounded-lg border bg-muted overflow-hidden">
            <div class="aspect-video overflow-hidden">
              <img
                src="https://imagedelivery.net/${photo.cfImageId}/public"
                alt="${photo.roomType}"
                class="h-full w-full object-cover transition-transform group-hover:scale-105"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-1">${photo.roomType}</h3>
              <p class="text-xs text-muted-foreground mb-3">
                ${photo.listingAddress || 'No address'}
              </p>
              <button
                onclick="editPhoto(${photo.id})"
                class="w-full rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-background"
              >
                AI Edit
              </button>
            </div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Failed to load listing photos:', error);
        const grid = document.getElementById('listing-grid');
        if (grid) {
          grid.innerHTML = '<p class="col-span-full text-sm text-destructive">Failed to load listing photos. Please try again.</p>';
        }
      }
    }

    // Handle listing photo upload
    const uploadForm = document.getElementById('upload-listing-form');
    if (uploadForm) {
      uploadForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fileInput = document.getElementById('listing-file') as HTMLInputElement;
        const roomTypeInput = document.getElementById('room-type') as HTMLInputElement;
        const file = fileInput.files?.[0];

        if (!file) {
          alert('Please select a photo');
          return;
        }

        const formData = new FormData();
        formData.append('image', file);
        formData.append('roomType', roomTypeInput.value);

        try {
          const response = await fetch('/api/listing-photos', {
            method: 'POST',
            body: formData,
          });

          if (!response.ok) {
            throw new Error('Upload failed');
          }

          alert('Listing photo uploaded successfully!');
          fileInput.value = '';
          roomTypeInput.value = '';
          loadListingPhotos();
        } catch (error) {
          console.error('Upload error:', error);
          alert('Failed to upload listing photo. Please try again.');
        }
      });
    }

    // Edit photo function
    (window as any).editPhoto = function(photoId: number) {
      const prompt = window.prompt('Enter AI editing prompt (e.g., "modern furniture", "brighter lighting"):');
      if (!prompt) return;

      fetch(`/api/listing-photos/${photoId}/edit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      })
        .then(response => {
          if (!response.ok) throw new Error('Edit failed');
          alert('AI edit request submitted! Check back soon for results.');
        })
        .catch(error => {
          console.error('Edit error:', error);
          alert('Failed to submit AI edit. Please try again.');
        });
    };

    // Load photos on page load
    loadListingPhotos();
  </script>
</BaseLayout>
