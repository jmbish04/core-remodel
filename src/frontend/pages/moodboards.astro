---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mood Boards - 126 Colby - Remodel Mission Control"
  description="Create and manage mood boards for your renovation projects"
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold mb-2">Mood Boards</h1>
        <p class="text-muted-foreground">Organize your design inspiration with drag-and-drop boards</p>
        <p id="boards-feedback" class="mt-2 text-sm text-muted-foreground"></p>
      </div>
      <button
        id="create-board-btn"
        class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        + Create Board
      </button>
    </div>

    <div id="boards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <p class="col-span-full text-sm text-muted-foreground">Loading mood boards...</p>
    </div>

    <div id="create-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div class="bg-background rounded-lg p-6 max-w-md w-full mx-4">
        <h2 class="text-xl font-semibold mb-4">Create New Mood Board</h2>
        <form id="create-form" class="space-y-4">
          <div>
            <label for="board-name" class="block text-sm font-medium mb-2">
              Board Name
            </label>
            <input
              type="text"
              id="board-name"
              required
              class="w-full rounded-md border bg-background px-3 py-2 text-sm"
              placeholder="e.g., Kitchen Remodel"
            />
          </div>
          <div>
            <label for="board-description" class="block text-sm font-medium mb-2">
              Description
            </label>
            <textarea
              id="board-description"
              rows={3}
              class="w-full rounded-md border bg-background px-3 py-2 text-sm"
              placeholder="Optional description..."
            ></textarea>
          </div>
          <div class="flex gap-2 justify-end">
            <button
              type="button"
              id="cancel-btn"
              class="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
            >
              Create
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    function slugifyMoodboard(name: string, id: number) {
      const slug = name
        .toLowerCase()
        .trim()
        .replace(/['"]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return slug || `board-${id}`;
    }

    function formatBoardDate(value: unknown) {
      if (!value) return 'Unknown';
      const date = new Date(value as string | number | Date);
      if (Number.isNaN(date.getTime())) return 'Unknown';
      return date.toLocaleDateString();
    }

    function setBoardFeedback(message: string, tone: 'muted' | 'destructive' = 'muted') {
      const feedback = document.getElementById('boards-feedback');
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = tone === 'destructive'
        ? 'mt-2 text-sm text-destructive'
        : 'mt-2 text-sm text-muted-foreground';
    }

    // Load mood boards
    async function loadBoards() {
      try {
        const response = await fetch('/api/moodboards');
        const data = await response.json();

        const grid = document.getElementById('boards-grid');
        if (!grid) return;

        if (!data.moodBoards || data.moodBoards.length === 0) {
          grid.innerHTML = '<p class="col-span-full text-sm text-muted-foreground">No mood boards yet. Create one to get started!</p>';
          setBoardFeedback('');
          return;
        }

        grid.innerHTML = data.moodBoards.map((board: any) => `
          <a href="/moodboards/${slugifyMoodboard(board.name, board.id)}" class="group block rounded-lg border bg-card p-6 transition-colors hover:bg-muted/50">
            <h3 class="text-lg font-semibold mb-2">${board.name}</h3>
            <p class="text-sm text-muted-foreground mb-4">${board.description || 'No description'}</p>
            <div class="text-xs text-muted-foreground">
              Created ${formatBoardDate(board.datetimeCreated)}
            </div>
          </a>
        `).join('');
        setBoardFeedback('');
      } catch (error) {
        setBoardFeedback(
          error instanceof Error ? error.message : 'Failed to load mood boards.',
          'destructive',
        );
        const grid = document.getElementById('boards-grid');
        if (grid) {
          grid.innerHTML = '<p class="col-span-full text-sm text-destructive">Failed to load mood boards. Please try again.</p>';
        }
      }
    }

    // Show/hide create modal
    const modal = document.getElementById('create-modal');
    const createBtn = document.getElementById('create-board-btn');
    const cancelBtn = document.getElementById('cancel-btn');

    if (createBtn && modal) {
      createBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
      });
    }

    if (cancelBtn && modal) {
      cancelBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
    }

    // Handle create form
    const createForm = document.getElementById('create-form');
    if (createForm && modal) {
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('board-name') as HTMLInputElement;
        const descInput = document.getElementById('board-description') as HTMLTextAreaElement;

        try {
          const response = await fetch('/api/moodboards', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nameInput.value,
              description: descInput.value || null,
              layoutState: {},
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to create mood board');
          }

          modal.classList.add('hidden');
          nameInput.value = '';
          descInput.value = '';
          setBoardFeedback('Mood board created.');
          loadBoards();
        } catch (error) {
          setBoardFeedback(
            error instanceof Error ? error.message : 'Failed to create mood board.',
            'destructive',
          );
        }
      });
    }

    window.addEventListener('global-upload-complete', () => {
      loadBoards();
    });

    // Load boards on page load
    loadBoards();
  </script>
</BaseLayout>
