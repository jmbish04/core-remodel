---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Navigation } from "@/components/Navigation";
---

<BaseLayout
  title="Mood Boards - Remodel Mood Board"
  description="Create and manage mood boards for your renovation projects"
>
  <Navigation client:load />
  <main className="container mx-auto px-4 py-8">
    <div className="mb-8 flex items-center justify-between">
      <div>
        <h1 className="text-3xl font-bold mb-2">Mood Boards</h1>
        <p className="text-muted-foreground">Organize your design inspiration with drag-and-drop boards</p>
      </div>
      <button
        id="create-board-btn"
        className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        + Create Board
      </button>
    </div>

    <div id="boards-grid" className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <p className="col-span-full text-sm text-muted-foreground">Loading mood boards...</p>
    </div>

    <div id="create-modal" className="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div className="bg-background rounded-lg p-6 max-w-md w-full mx-4">
        <h2 className="text-xl font-semibold mb-4">Create New Mood Board</h2>
        <form id="create-form" className="space-y-4">
          <div>
            <label htmlFor="board-name" className="block text-sm font-medium mb-2">
              Board Name
            </label>
            <input
              type="text"
              id="board-name"
              required
              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
              placeholder="e.g., Kitchen Remodel"
            />
          </div>
          <div>
            <label htmlFor="board-description" className="block text-sm font-medium mb-2">
              Description
            </label>
            <textarea
              id="board-description"
              rows={3}
              className="w-full rounded-md border bg-background px-3 py-2 text-sm"
              placeholder="Optional description..."
            ></textarea>
          </div>
          <div className="flex gap-2 justify-end">
            <button
              type="button"
              id="cancel-btn"
              className="rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted"
            >
              Cancel
            </button>
            <button
              type="submit"
              className="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
            >
              Create
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    // Load mood boards
    async function loadBoards() {
      try {
        const response = await fetch('/api/moodboards');
        const data = await response.json();

        const grid = document.getElementById('boards-grid');
        if (!grid) return;

        if (!data.moodBoards || data.moodBoards.length === 0) {
          grid.innerHTML = '<p class="col-span-full text-sm text-muted-foreground">No mood boards yet. Create one to get started!</p>';
          return;
        }

        grid.innerHTML = data.moodBoards.map((board: any) => `
          <a href="/moodboards/${board.id}" class="group block rounded-lg border bg-card p-6 transition-colors hover:bg-muted/50">
            <h3 class="text-lg font-semibold mb-2">${board.name}</h3>
            <p class="text-sm text-muted-foreground mb-4">${board.description || 'No description'}</p>
            <div class="text-xs text-muted-foreground">
              Created ${new Date(board.createdAt).toLocaleDateString()}
            </div>
          </a>
        `).join('');
      } catch (error) {
        console.error('Failed to load mood boards:', error);
        const grid = document.getElementById('boards-grid');
        if (grid) {
          grid.innerHTML = '<p class="col-span-full text-sm text-destructive">Failed to load mood boards. Please try again.</p>';
        }
      }
    }

    // Show/hide create modal
    const modal = document.getElementById('create-modal');
    const createBtn = document.getElementById('create-board-btn');
    const cancelBtn = document.getElementById('cancel-btn');

    if (createBtn && modal) {
      createBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
      });
    }

    if (cancelBtn && modal) {
      cancelBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
    }

    // Handle create form
    const createForm = document.getElementById('create-form');
    if (createForm && modal) {
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('board-name') as HTMLInputElement;
        const descInput = document.getElementById('board-description') as HTMLTextAreaElement;

        try {
          const response = await fetch('/api/moodboards', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nameInput.value,
              description: descInput.value || null,
              layoutState: {},
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to create mood board');
          }

          modal.classList.add('hidden');
          nameInput.value = '';
          descInput.value = '';
          loadBoards();
        } catch (error) {
          console.error('Create error:', error);
          alert('Failed to create mood board. Please try again.');
        }
      });
    }

    // Load boards on page load
    loadBoards();
  </script>
</BaseLayout>
