---
import { getDocsPageBySlug } from "@/lib/docs";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { MermaidDiagram } from "@/components/docs/MermaidDiagram";
import {
  ExternalLink,
  CheckCircle2,
  ArrowLeft,
  AlertCircle
} from "lucide-react";

const { audience = "", slug = "" } = Astro.params;
const page = getDocsPageBySlug([audience, slug]);

if (!page) {
  return Astro.redirect("/docs");
}
---

<BaseLayout
  title={`${page.title} — 126 Colby Remodel Mission Control`}
  description={page.summary}
>
  <main class="container mx-auto px-4 py-8">
    <!-- Breadcrumb back link -->
    <div class="mb-6">
      <a 
        href="/docs" 
        class="inline-flex items-center gap-2 text-sm text-muted-foreground transition hover:text-foreground"
      >
        <ArrowLeft className="size-4" />
        Back to Documentation Overview
      </a>
    </div>

    <!-- Editorial Hero Header -->
    <header class="relative mb-10 overflow-hidden rounded-2xl border border-border/40 bg-card/40 p-8 md:p-12 lg:p-16">
      <div class="absolute inset-0 bg-gradient-to-tr from-primary/5 via-transparent to-transparent"></div>
      <div class="relative z-10 max-w-3xl space-y-4">
        <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          {page.audienceLabel}
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl lg:text-6xl text-foreground">
          {page.title}
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground font-light leading-relaxed">
          {page.summary}
        </p>
      </div>
    </header>

    <!-- Content Split Layout -->
    <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
      
      <!-- Left Column: Rich Documentation Sections -->
      <article class="space-y-12">
        
        <!-- Overview Statement -->
        <section class="prose prose-slate dark:prose-invert max-w-none rounded-xl border border-border/30 bg-muted/10 p-6 md:p-8">
          <h2 class="mt-0 text-xl font-bold tracking-tight">Overview</h2>
          <p class="text-muted-foreground leading-relaxed text-base md:text-lg font-light">
            {page.overview}
          </p>
        </section>

        <!-- Dynamic Sections -->
        {page.sections.map((section) => (
          <section id={section.id} class="scroll-mt-20 space-y-6 border-b border-border/20 pb-8 last:border-0 last:pb-0">
            <header class="space-y-2">
              <h2 class="text-2xl font-bold tracking-tight text-foreground flex items-center gap-3">
                <span class="size-2 rounded-full bg-primary/70"></span>
                {section.title}
              </h2>
              <p class="text-sm font-medium text-muted-foreground/80">{section.summary}</p>
            </header>

            <div class="space-y-4 text-muted-foreground leading-relaxed font-light">
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            {section.diagrams && section.diagrams.length > 0 && (
              <div class="space-y-4">
                {section.diagrams.map((diagram) => (
                  <MermaidDiagram client:only="react" code={diagram.code} caption={diagram.caption} />
                ))}
              </div>
            )}

            {section.bullets && section.bullets.length > 0 && (
              <ul class="space-y-2.5 rounded-lg border border-border/20 bg-muted/5 p-5 pl-10 list-disc text-muted-foreground font-light">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}

            {section.note && (
              <div class="flex gap-4 rounded-xl border border-amber-500/20 bg-amber-500/5 p-5 text-sm text-amber-500/90 dark:border-amber-400/20 dark:bg-amber-400/5 dark:text-amber-350">
                <AlertCircle className="size-5 shrink-0" />
                <div class="space-y-1">
                  <p class="font-semibold uppercase tracking-wider text-[11px]">{section.note.title}</p>
                  <p class="font-light leading-relaxed">{section.note.body}</p>
                </div>
              </div>
            )}

            {section.actions && section.actions.length > 0 && (
              <div class="flex flex-wrap gap-3 pt-2">
                {section.actions.map((act) => (
                  <a 
                    href={act.href}
                    class={cn(buttonVariants({ variant: "outline", size: "sm" }), "gap-2")}
                  >
                    <ExternalLink className="size-3.5" />
                    <span>{act.label}</span>
                  </a>
                ))}
              </div>
            )}
          </section>
        ))}
      </article>

      <!-- Right Column: Sidebar Actions & Highlights -->
      <aside class="space-y-6 lg:sticky lg:top-24 h-fit">
        
        <!-- Highlights Box -->
        <div class="rounded-xl border border-border/40 bg-card p-5 space-y-4 shadow-sm ring-1 ring-border/20">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
            Core Highlights
          </h3>
          <ul class="space-y-4">
            {page.highlights.map((highlight) => (
              <li class="flex gap-3 text-xs leading-relaxed text-muted-foreground font-light">
                <CheckCircle2 className="size-4 shrink-0 text-primary mt-0.5" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Quick Actions Menu -->
        {page.actions && page.actions.length > 0 && (
          <div class="rounded-xl border border-border/40 bg-card p-5 space-y-4 shadow-sm ring-1 ring-border/20">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
              Direct Workspace Actions
            </h3>
            <div class="space-y-3">
              {page.actions.map((act) => (
                <a 
                  href={act.href}
                  class="group block p-3 rounded-lg border border-border/40 bg-muted/20 hover:bg-muted/40 transition text-left"
                >
                  <p class="text-xs font-semibold text-foreground group-hover:text-primary transition flex items-center justify-between">
                    <span>{act.label}</span>
                    <ExternalLink className="size-3 text-muted-foreground group-hover:text-primary transition" />
                  </p>
                  <p class="text-[11px] text-muted-foreground mt-1 font-light leading-relaxed">
                    {act.description}
                  </p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Quick Document Outline -->
        <div class="rounded-xl border border-border/40 bg-card p-5 space-y-3 shadow-sm ring-1 ring-border/20">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
            Document Outline
          </h3>
          <nav class="space-y-1 text-xs">
            {page.sections.map((section) => (
              <a 
                href={`#${section.id}`} 
                class="block py-1.5 text-muted-foreground transition hover:text-foreground font-light border-l-2 border-transparent pl-3 hover:border-border"
              >
                {section.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </main>
</BaseLayout>
