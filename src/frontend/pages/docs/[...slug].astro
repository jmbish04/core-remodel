---
import DocsArticle from "@/components/docs/DocsArticle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDocsPageBySlug } from "@/lib/docs";

const slug = Astro.params.slug;
const page = getDocsPageBySlug(slug);

if (!page) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={page ? `${page.title} - 126 Colby - Remodel Mission Control` : "Documentation Not Found - 126 Colby - Remodel Mission Control"}
  description={page?.summary || "Requested documentation page was not found."}
>
  {page ? (
    <DocsArticle page={page} />
  ) : (
    <main class="container mx-auto px-4 py-12">
      <div class="rounded-[1.75rem] border border-border/60 bg-card/70 p-8">
        <span class="rounded-full border border-border/60 bg-background/70 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-muted-foreground">
          Documentation
        </span>
        <h1 class="mt-5 text-3xl font-semibold tracking-tight">Guide not found</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
          The requested documentation page does not exist. Return to the overview to choose a valid
          homeowner, contractor, or shared workflow guide.
        </p>
        <a
          href="/docs"
          class="mt-6 inline-flex rounded-full border border-border/60 bg-background/75 px-4 py-2 text-sm font-medium transition hover:border-primary/40 hover:bg-primary/10"
        >
          Back to docs overview
        </a>
      </div>
    </main>
  )}
</BaseLayout>
