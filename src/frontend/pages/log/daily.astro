---
import { ProjectLogApp } from "@/components/ProjectLogApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Daily Log - 126 Colby - Remodel Mission Control"
  description="Voice-first daily jobsite log with task update mapping and photo evidence."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Daily Log</h1>
      <p class="text-muted-foreground">
        Capture daily field notes, update expected tasks, and submit photo-backed progress entries.
      </p>
    </div>

    <ProjectLogApp client:only="react" logType="daily" />
  </main>
</BaseLayout>
