---
import { EstimateIntakeWizardApp } from "@/components/EstimateIntakeWizardApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="New Estimate Intake - 126 Colby Remodel Mission Control"
  description="Wizard intake for estimate source processing, AI extraction, confirmation, autosave drafts, and submission."
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight">New Estimate Intake</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Upload or provide estimate source details, review extraction, confirm fields, and submit.
      </p>
    </div>
    <EstimateIntakeWizardApp client:only="react" />
  </main>
</BaseLayout>

