---
import { ImagesGridEditor } from "@/components/ImagesGridEditor";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { slug } = Astro.params;
const requestedIdentifier = slug ?? "";
---

<BaseLayout
  title="Mood Board - 126 Colby - Remodel Mission Control"
  description="View and manage a specific mood board"
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/moodboards" class="text-sm text-muted-foreground hover:text-foreground">
        ← Back to Mood Boards
      </a>
    </div>

    <section class="grid gap-6">
      <div class="rounded-lg border bg-card p-6">
        <div id="board-content">
          <p class="text-sm text-muted-foreground">Loading mood board...</p>
        </div>
      </div>

      <div class="rounded-lg border bg-card p-6">
        <div class="mb-4">
          <h2 class="text-xl font-semibold">Recent Uploads</h2>
        </div>
        <ImagesGridEditor
          client:only="react"
          maxItems={20}
          emptyMessage="No images yet."
        />
      </div>
    </section>
  </main>

  <script define:vars={{ requestedIdentifier }}>

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function formatBoardDate(value) {
      if (!value) return "Unknown";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "Unknown";
      return date.toLocaleDateString();
    }

    async function loadBoard() {
      const boardContent = document.getElementById("board-content");
      if (!boardContent) return;

      try {
        const response = await fetch(`/api/moodboards/resolve/${encodeURIComponent(requestedIdentifier)}`);
        const data = await response.json();

        if (!response.ok || !data.moodBoard) {
          boardContent.innerHTML = `
            <h1 class="text-2xl font-bold mb-2">Mood board not found</h1>
            <p class="text-sm text-muted-foreground">This board may have been deleted or the URL is incorrect.</p>
          `;
          return;
        }

        const board = data.moodBoard;
        const canonicalPath = data.canonicalPath;
        if (canonicalPath && window.location.pathname !== canonicalPath) {
          window.location.replace(canonicalPath);
          return;
        }

        boardContent.innerHTML = `
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="mb-2 text-3xl font-bold">${escapeHtml(board.name)}</h1>
              <p class="text-muted-foreground">${escapeHtml(board.description || "No description")}</p>
            </div>
            <div class="text-right text-sm text-muted-foreground">
              <p>Created ${formatBoardDate(board.datetimeCreated)}</p>
              <p>Last updated ${formatBoardDate(board.datetimeLastModified)}</p>
            </div>
          </div>
        `;

      } catch (error) {
        const message =
          error instanceof Error ? error.message : "Failed to load mood board";
        boardContent.innerHTML = `
          <h1 class="text-2xl font-bold mb-2">Failed to load mood board</h1>
          <p class="text-sm text-destructive">${escapeHtml(message)}</p>
        `;
      }
    }

    loadBoard();
  </script>
</BaseLayout>
