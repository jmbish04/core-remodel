---
import { HomeMissionControlApp } from "@/components/HomeMissionControlApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="126 Colby - Remodel Mission Control"
  description="Contractor-first command center for listing photos, inspiration, and remodel decisions."
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight">126 Colby - Remodel Mission Control</h1>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Shared source of truth for contractors, designers, and homeowners to review existing
        conditions, inspiration, and in-progress remodel decisions.
      </p>
    </div>

    <HomeMissionControlApp client:only="react" />
  </main>
</BaseLayout>
