---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Remodel Mood Board - AI-Powered Renovation Planning"
  description="Create mood boards and manage renovation images with AI-powered analysis on Cloudflare"
>
  <main class="container mx-auto px-4 py-12">
    <div className="max-w-4xl mx-auto text-center mb-12">
      <h1 className="text-5xl font-bold mb-4 bg-gradient-to-r from-primary to-primary/60 bg-clip-text text-transparent">
        Remodel Mood Board
      </h1>
      <p className="text-xl text-muted-foreground mb-8">
        AI-powered image management and mood board creation for your home renovation projects
      </p>
      <div className="flex gap-4 justify-center">
        <a
          href="/gallery"
          className="rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Browse Gallery
        </a>
        <a
          href="/moodboards"
          className="rounded-md border px-6 py-3 text-sm font-medium hover:bg-muted"
        >
          View Mood Boards
        </a>
      </div>
    </div>

    <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div className="rounded-lg border bg-card p-6">
        <div className="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
            <circle cx="9" cy="9" r="2"/>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
          </svg>
        </div>
        <h3 className="text-lg font-semibold mb-2">AI Image Analysis</h3>
        <p className="text-sm text-muted-foreground">
          Automatically detect room types, extract keywords, and identify Instagram screenshots with Cloudflare Workers AI
        </p>
      </div>

      <div className="rounded-lg border bg-card p-6">
        <div className="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="7" x="3" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="14" rx="1"/>
            <rect width="7" height="7" x="3" y="14" rx="1"/>
          </svg>
        </div>
        <h3 className="text-lg font-semibold mb-2">Mood Boards</h3>
        <p className="text-sm text-muted-foreground">
          Create and organize design inspiration with drag-and-drop mood boards for your renovation projects
        </p>
      </div>

      <div className="rounded-lg border bg-card p-6">
        <div className="mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" x2="12" y1="3" y2="15"/>
          </svg>
        </div>
        <h3 className="text-lg font-semibold mb-2">Semantic Search</h3>
        <p className="text-sm text-muted-foreground">
          Find images using natural language with vector embeddings powered by Cloudflare Vectorize
        </p>
      </div>
    </div>

    <div className="rounded-lg border bg-card p-8 text-center">
      <h2 className="text-2xl font-semibold mb-4">Powered by Cloudflare</h2>
      <p className="text-muted-foreground mb-4">
        Built on Cloudflare's ecosystem: Workers AI, D1 Database, Vectorize, Images, and R2 Storage
      </p>
      <div className="flex gap-3 justify-center text-sm">
        <a href="/openapi.json" className="text-primary hover:underline">OpenAPI Spec</a>
        <span className="text-muted-foreground">·</span>
        <a href="/scalar" className="text-primary hover:underline">Scalar Docs</a>
        <span className="text-muted-foreground">·</span>
        <a href="/swagger" className="text-primary hover:underline">Swagger UI</a>
      </div>
    </div>
  </main>
</BaseLayout>
