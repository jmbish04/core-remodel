---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SupportingDocumentsApp } from "@/components/SupportingDocumentsApp";
---

<BaseLayout
  title="Supporting Documents Admin - 126 Colby - Remodel Mission Control"
  description="Admin workspace for uploading, tagging, and branching supporting documents and vision nodes."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Supporting Documents Admin</h1>
      <p class="text-muted-foreground">
        Upload records, attach them to rooms and scenarios, and maintain the editable vision-node workspace.
      </p>
    </div>

    <SupportingDocumentsApp client:only="react" />
  </main>
</BaseLayout>
