---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PhotoReviewApp } from "@/components/PhotoReviewApp";
---

<BaseLayout
  title="Photo Reviews - 126 Colby - Remodel Mission Control"
  description="Code listing photos and categorize level/home-scoped inspiration with AI-assisted suggestions."
>
  {/*
    Two tabs live inside PhotoReviewApp: the per-image coding workspace and the
    level/home inspiration categorizer + grouped viewer (feature 0005). The
    shell owns its own height under the 3.5rem navbar, so no extra wrapper sizing
    is needed here.
  */}
  <div class="pt-[1px]">
    <PhotoReviewApp client:only="react" />
  </div>
</BaseLayout>

