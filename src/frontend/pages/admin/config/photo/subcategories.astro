---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ConfigDefinitionPage } from "@/components/config";
---

<BaseLayout title="Photo Sub-categories — Configuration" description="Manage sub-categories within each photo & product category.">
  <ConfigDefinitionPage
    client:only="react"
    activeHref="/admin/config/photo/subcategories"
    title="Photo Sub-categories"
    description="Sub-categories belong to a category — pick one to view and add its entries."
    endpoint="/api/config/subcategories"
    columns={["name", "description"]}
    withCategoryFilter
  />
</BaseLayout>
