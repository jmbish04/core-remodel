---
import { ContractsApp } from "@/components/ContractsApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contracts - 126 Colby Remodel Mission Control"
  description="Track contract drafts, revisions, risk findings, and payment milestone controls."
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight">Contracts</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Monitor contract obligations, analyze risk, and keep payment/timeline controls auditable.
      </p>
    </div>
    <ContractsApp client:only="react" />
  </main>
</BaseLayout>

