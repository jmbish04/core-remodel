---
import { EstimatesApp } from "@/components/EstimatesApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Estimates - 126 Colby Remodel Mission Control"
  description="Track remodeling estimates, revisions, source extraction, and draft intake workflows."
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight">Estimates</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Intake, revise, and monitor contractor and vendor estimates with structured extraction and audit history.
      </p>
    </div>
    <EstimatesApp client:only="react" />
  </main>
</BaseLayout>

