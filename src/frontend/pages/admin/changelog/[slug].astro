---
/**
 * @fileoverview Changelog viewport — one SHIPPED change, seen from every angle.
 *
 * Renders the shared entry template: diagrams (mermaidcn zoom/pan), the
 * changelog19 developer changelog with code snippets, and the changelog21
 * Features/Fixes/Improvements recap. Its proposed twin is
 * /admin/changelog/preview/[slug] — same template, `staged` stage.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChangelogEntryView from "@/components/changelog/ChangelogEntryView.astro";

const slug = Astro.params.slug as string;
---

<BaseLayout
  title={`${slug} - Changelog - 126 Colby - Remodel Mission Control`}
  description="A shipped change: what it introduced, how it was built, and the code behind it."
>
  <ChangelogEntryView slug={slug} stage="shipped" />
</BaseLayout>
