---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PermitsAdminApp } from "@/components/PermitsAdminApp";
---

<BaseLayout
  title="Contractor Permit Intelligence - 126 Colby - Remodel Mission Control"
  description="Contractor permit activity and workload analytics for contacts tied to 126 Colby permits."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Contractor Permit Intelligence</h1>
      <p class="text-muted-foreground">
        Review contact-level permit workload, risk flags, and Bay Area permit activity map by contractor.
      </p>
    </div>

    <PermitsAdminApp section="contacts" client:only="react" />
  </main>
</BaseLayout>
