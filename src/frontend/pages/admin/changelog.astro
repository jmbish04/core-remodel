---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRANCHES, CHANGELOG, type ChangeKind } from "@/data/changelog";
import { CHANGELOG_DETAIL } from "@/data/changelog-detail";
import { MermaidCn } from "@/components/mermaidcn/MermaidCn";

const KIND: Record<ChangeKind, { label: string; cls: string; dot: string }> = {
  added: { label: "Added", cls: "bg-emerald-500/12 text-emerald-300", dot: "bg-emerald-400" },
  changed: { label: "Changed", cls: "bg-sky-500/12 text-sky-300", dot: "bg-sky-400" },
  removed: { label: "Removed", cls: "bg-rose-500/12 text-rose-300", dot: "bg-rose-400" },
  migration: { label: "Migration", cls: "bg-violet-500/12 text-violet-300", dot: "bg-violet-400" },
  fixed: { label: "Fixed", cls: "bg-amber-500/12 text-amber-300", dot: "bg-amber-400" },
};

const STATUS: Record<string, { label: string; cls: string; dot: string }> = {
  shipped: { label: "Shipped", cls: "bg-emerald-500/12 text-emerald-300", dot: "bg-emerald-400" },
  staged: { label: "Staged", cls: "bg-amber-500/12 text-amber-300", dot: "bg-amber-400" },
  open: { label: "Open", cls: "bg-sky-500/12 text-sky-300", dot: "bg-sky-400" },
};

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

// Group entries under their branch (newest branch first, as ordered in BRANCHES).
const groups = BRANCHES.map((b) => ({
  branch: b,
  entries: CHANGELOG.filter((e) => e.branch === b.branch),
}));
// Any entries whose branch isn't declared still show under an "Unfiled" group.
const declared = new Set(BRANCHES.map((b) => b.branch));
const orphans = CHANGELOG.filter((e) => !declared.has(e.branch));
---

<BaseLayout
  title="Changelog — The Monolith"
  description="Every change grouped by branch and pull request."
>
  <main class="container mx-auto max-w-4xl px-4 py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold tracking-tight">Changelog</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Every change grouped by branch and pull request — newest first.
        <span class="ml-1 align-middle text-amber-300/90">Staged</span>
        <span class="text-muted-foreground/60"> = merged, not yet applied to prod.</span>
      </p>
    </header>

    <div class="space-y-8">
      {
        groups.map(({ branch, entries }) => {
          const st = STATUS[branch.status] ?? STATUS.staged;
          return (
            <section class="rounded-xl bg-card p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]">
              {/* ── Branch / PR header ── */}
              <div class="flex flex-wrap items-center gap-2">
                <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-medium ${st.cls}`}>
                  <span class={`inline-block size-1.5 rounded-full ${st.dot}`} />
                  {st.label}
                </span>
                {branch.prNumber ? (
                  <a
                    href={branch.prUrl ?? "#"}
                    target="_blank"
                    rel="noreferrer"
                    class="rounded-md bg-primary/15 px-2 py-0.5 font-mono text-[11px] font-semibold text-primary hover:bg-primary/25"
                  >
                    PR #{branch.prNumber}
                  </a>
                ) : (
                  <span class="rounded-md bg-muted/60 px-2 py-0.5 font-mono text-[11px] text-muted-foreground/70">
                    PR not opened yet
                  </span>
                )}
                <span class="rounded bg-muted/40 px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground/70">
                  {branch.branch}
                </span>
                <time class="ml-auto text-[11px] tabular-nums text-muted-foreground/70">{fmtDate(branch.date)}</time>
              </div>

              <h2 class="mt-3 text-xl font-semibold tracking-tight">{branch.title}</h2>
              {branch.summary && (
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{branch.summary}</p>
              )}

              {/* ── Branch-level diagrams (architecture + build timeline) ── */}
              {branch.diagrams && branch.diagrams.length > 0 && (
                <details class="group mt-4 rounded-lg bg-muted/20 p-3">
                  <summary class="cursor-pointer list-none text-xs font-medium text-muted-foreground hover:text-foreground">
                    <span class="inline-block transition-transform group-open:rotate-90">▸</span>
                    Diagrams — architecture &amp; build timeline
                  </summary>
                  <div class="mt-4 space-y-6">
                    {branch.diagrams.map((d) => (
                      <MermaidCn code={d.code} caption={d.caption} client:visible />
                    ))}
                  </div>
                </details>
              )}

              {/* ── Nested phase entries ── */}
              <ol class="mt-5 space-y-4 border-l border-border/40 pl-4">
                {entries.map((entry) => (
                  <li class="relative">
                    <span class="absolute -left-[21px] top-1.5 size-2 rounded-full bg-primary/60 ring-4 ring-card" />
                    <div class="flex flex-wrap items-center gap-2">
                      {entry.tag && (
                        <span class="rounded-md bg-primary/15 px-2 py-0.5 text-[11px] font-semibold text-primary">
                          {entry.tag}
                        </span>
                      )}
                      {CHANGELOG_DETAIL[entry.id] ? (
                        <a href={`/admin/changelog/${entry.id}`} class="text-base font-semibold tracking-tight hover:text-primary hover:underline underline-offset-4">
                          {entry.title}
                        </a>
                      ) : (
                        <h3 class="text-base font-semibold tracking-tight">{entry.title}</h3>
                      )}
                      {CHANGELOG_DETAIL[entry.id] && (
                        <a href={`/admin/changelog/${entry.id}`} class="ml-auto shrink-0 rounded-md bg-muted/50 px-2 py-0.5 text-[11px] text-muted-foreground hover:bg-muted/70 hover:text-foreground">
                          Details →
                        </a>
                      )}
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>

                    <ul class="mt-2.5 space-y-1.5">
                      {entry.changes.map((ch) => (
                        <li class="flex items-start gap-2.5 text-sm">
                          <span class={`mt-0.5 inline-flex shrink-0 items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide ${KIND[ch.kind].cls}`}>
                            <span class={`inline-block size-1.5 rounded-full ${KIND[ch.kind].dot}`} />
                            {KIND[ch.kind].label}
                          </span>
                          <span class="text-foreground/90">{ch.text}</span>
                        </li>
                      ))}
                    </ul>

                    {entry.migrations && entry.migrations.length > 0 && (
                      <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] text-muted-foreground/60">Migrations</span>
                        {entry.migrations.map((m) => (
                          <code class="rounded bg-muted/60 px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">{m}</code>
                        ))}
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }

      {orphans.length > 0 && (
        <section class="rounded-xl bg-card p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]">
          <h2 class="text-lg font-semibold">Unfiled changes</h2>
          <p class="mt-1 text-sm text-muted-foreground">Entries whose branch isn’t declared in BRANCHES.</p>
          <ul class="mt-3 space-y-2">
            {orphans.map((e) => (
              <li class="text-sm">
                <span class="font-medium">{e.title}</span>
                <span class="ml-2 font-mono text-xs text-muted-foreground/70">{e.branch}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <p class="mt-6 text-xs text-muted-foreground/60">
      Comparing component layouts? See <a href="/admin/changelog/preview" class="underline underline-offset-4">the changelog block preview</a>.
    </p>
  </main>
</BaseLayout>
