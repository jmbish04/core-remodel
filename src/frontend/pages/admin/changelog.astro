---
import { drizzle } from "drizzle-orm/d1";
import { desc } from "drizzle-orm";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BRANCHES, CHANGELOG, type ChangeKind } from "@/data/changelog";
import { CHANGELOG_DETAIL } from "@/data/changelog-detail";
import { changelogBranches, changelogEntries } from "@backend/db/schema/changelog/changelog";

const KIND: Record<ChangeKind, { label: string; cls: string; dot: string }> = {
  added: { label: "Added", cls: "bg-emerald-500/12 text-emerald-300", dot: "bg-emerald-400" },
  changed: { label: "Changed", cls: "bg-sky-500/12 text-sky-300", dot: "bg-sky-400" },
  removed: { label: "Removed", cls: "bg-rose-500/12 text-rose-300", dot: "bg-rose-400" },
  migration: { label: "Migration", cls: "bg-violet-500/12 text-violet-300", dot: "bg-violet-400" },
  fixed: { label: "Fixed", cls: "bg-amber-500/12 text-amber-300", dot: "bg-amber-400" },
};
const STATUS: Record<string, { label: string; cls: string; dot: string }> = {
  shipped: { label: "Shipped", cls: "bg-emerald-500/12 text-emerald-300", dot: "bg-emerald-400" },
  staged: { label: "Staged", cls: "bg-amber-500/12 text-amber-300", dot: "bg-amber-400" },
  open: { label: "Open", cls: "bg-sky-500/12 text-sky-300", dot: "bg-sky-400" },
};
const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

type Branch = { branch: string; title: string; summary: string | null; date: string; status: string; prNumber: number | null; prUrl: string | null };
type Entry = { id: string; branch: string; tag: string | null; area: string; title: string; summary: string; status: string; date: string; changes: Array<{ kind: ChangeKind; text: string }>; migrations: string[]; hasDetail: boolean };

// Source of truth is D1 (accumulates across branches, never overwritten). Fall
// back to bundled data when the table is empty (fresh DB / not yet seeded) or
// unavailable (not migrated yet).
let branchList: Branch[];
let entryList: Entry[];
let fromDb = false;
try {
  const db = drizzle(Astro.locals.runtime.env.DB);
  const [bRows, eRows] = await Promise.all([
    db.select().from(changelogBranches).orderBy(desc(changelogBranches.createdAt)),
    db.select().from(changelogEntries).orderBy(desc(changelogEntries.createdAt)),
  ]);
  if (eRows.length > 0) {
    fromDb = true;
    branchList = bRows.map((b) => ({ branch: b.branch, title: b.title, summary: b.summary, date: b.date, status: b.status, prNumber: b.prNumber, prUrl: b.prUrl }));
    entryList = eRows.map((e) => ({ id: e.slug, branch: e.branch, tag: e.tag, area: e.area, title: e.title, summary: e.summary, status: e.status, date: e.date, changes: (e.changesJson as Entry["changes"]) ?? [], migrations: (e.migrationsJson as string[]) ?? [], hasDetail: e.detailJson != null }));
  } else {
    throw new Error("empty");
  }
} catch {
  branchList = BRANCHES.map((b) => ({ branch: b.branch, title: b.title, summary: b.summary ?? null, date: b.date, status: b.status, prNumber: b.prNumber ?? null, prUrl: b.prUrl ?? null }));
  entryList = CHANGELOG.map((e) => ({ id: e.id, branch: e.branch, tag: e.tag ?? null, area: e.area, title: e.title, summary: e.summary, status: e.status, date: e.date, changes: e.changes, migrations: e.migrations ?? [], hasDetail: CHANGELOG_DETAIL[e.id] != null }));
}

const groups = branchList.map((b) => ({ branch: b, entries: entryList.filter((e) => e.branch === b.branch) }));
---

<BaseLayout title="Changelog - 126 Colby Remodel Mission Control" description="Every change grouped by branch and pull request — persistent, append-only.">
  <main class="container mx-auto max-w-4xl px-4 py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold tracking-tight">Changelog</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Every change grouped by branch and PR — newest first.
        <span class="ml-1 align-middle text-amber-300/90">Staged</span>
        <span class="text-muted-foreground/60"> = merged, not yet applied to prod.</span>
        <span class="ml-2 rounded bg-muted/50 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground/70">{fromDb ? "D1" : "bundled"}</span>
      </p>
    </header>

    <div class="space-y-8">
      {groups.map(({ branch, entries }) => {
        const st = STATUS[branch.status] ?? STATUS.staged;
        return (
          <section class="rounded-xl bg-card p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-medium ${st.cls}`}>
                <span class={`inline-block size-1.5 rounded-full ${st.dot}`} />{st.label}
              </span>
              {branch.prNumber ? (
                <a href={branch.prUrl ?? "#"} target="_blank" rel="noreferrer" class="rounded-md bg-primary/15 px-2 py-0.5 font-mono text-[11px] font-semibold text-primary hover:bg-primary/25">PR #{branch.prNumber}</a>
              ) : (
                <span class="rounded-md bg-muted/60 px-2 py-0.5 font-mono text-[11px] text-muted-foreground/70">PR not opened yet</span>
              )}
              <span class="rounded bg-muted/40 px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground/70">{branch.branch}</span>
              <time class="ml-auto text-[11px] tabular-nums text-muted-foreground/70">{fmtDate(branch.date)}</time>
            </div>
            <h2 class="mt-3 text-xl font-semibold tracking-tight">{branch.title}</h2>
            {branch.summary && <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{branch.summary}</p>}
            <ol class="mt-5 space-y-4 border-l border-border/40 pl-4">
              {entries.map((entry) => (
                <li class="relative">
                  <span class="absolute -left-[21px] top-1.5 size-2 rounded-full bg-primary/60 ring-4 ring-card" />
                  <div class="flex flex-wrap items-center gap-2">
                    {entry.tag && <span class="rounded-md bg-primary/15 px-2 py-0.5 text-[11px] font-semibold text-primary">{entry.tag}</span>}
                    {entry.hasDetail ? (
                      <a href={`/admin/changelog/${entry.id}`} class="text-base font-semibold tracking-tight hover:text-primary hover:underline underline-offset-4">{entry.title}</a>
                    ) : (
                      <h3 class="text-base font-semibold tracking-tight">{entry.title}</h3>
                    )}
                    <span class="ml-auto rounded bg-muted/40 px-1.5 py-0.5 text-[10px] text-muted-foreground/70">{entry.area}</span>
                    {entry.hasDetail && <a href={`/admin/changelog/${entry.id}`} class="rounded-md bg-muted/50 px-2 py-0.5 text-[11px] text-muted-foreground hover:bg-muted/70 hover:text-foreground">Details →</a>}
                  </div>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>
                  <ul class="mt-2.5 space-y-1.5">
                    {entry.changes.map((ch) => {
                      const k = KIND[ch.kind] ?? KIND.changed;
                      return (
                        <li class="flex items-start gap-2.5 text-sm">
                          <span class={`mt-0.5 inline-flex shrink-0 items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide ${k.cls}`}>
                            <span class={`inline-block size-1.5 rounded-full ${k.dot}`} />{k.label}
                          </span>
                          <span class="text-foreground/90">{ch.text}</span>
                        </li>
                      );
                    })}
                  </ul>
                  {entry.migrations.length > 0 && (
                    <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                      <span class="text-[11px] text-muted-foreground/60">Migrations</span>
                      {entry.migrations.map((m) => (
                        <code class="rounded bg-muted/60 px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">{m}</code>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>
