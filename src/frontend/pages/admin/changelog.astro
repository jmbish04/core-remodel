---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CHANGELOG, type ChangeKind } from "@/data/changelog";
import { Changelog24 } from "../../../components/beste/block/changelog24";

const KIND_LABEL: Record<ChangeKind, string> = {
  added: "Added",
  changed: "Changed",
  removed: "Removed",
  migration: "Migration",
  fixed: "Fixed",
};

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// Map the changelog data into the premium Changelog24 shape. The PR button
// appears once an entry is tied to a GitHub PR.
const entries = CHANGELOG.map((e) => ({
  version: e.tag ?? e.area,
  date: fmtDate(e.date),
  badge: {
    label: e.status === "staged" ? "Staged" : "Shipped",
    variant: (e.status === "staged" ? "outline" : "default") as "outline" | "default",
  },
  heading: e.title,
  description: e.summary,
  changes: [
    ...e.changes.map((ch) => `${KIND_LABEL[ch.kind]} — ${ch.text}`),
    ...(e.migrations && e.migrations.length ? [`Migrations — ${e.migrations.join(", ")}`] : []),
  ],
  button: e.prUrl ? { label: `PR #${e.prNumber ?? ""}`.trim(), href: e.prUrl } : undefined,
}));
---

<BaseLayout
  title="Changelog — The Monolith"
  description="Release notes for the remodel platform: what shipped, what changed, and what is staged for deploy."
>
  <main class="container mx-auto max-w-4xl px-4">
    <Changelog24
      heading="Changelog"
      description="What changed on the platform, newest first. “Staged” entries are merged but not yet applied to prod."
      badge={{ label: "Release notes", variant: "secondary" }}
      entries={entries}
    />
  </main>
</BaseLayout>
