---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { StoreViewportApp } from "@/components/showroom/StoreViewportApp";

const { id } = Astro.params;
const storeId = id ? Number.parseInt(id, 10) : NaN;
if (!Number.isFinite(storeId)) {
  return Astro.redirect("/admin/shopping/showrooms");
}
---

<BaseLayout
  title="Showroom — The Monolith"
  description="Single showroom viewport: location, hours, products carried, and research findings."
>
  <StoreViewportApp client:only="react" id={storeId} />
</BaseLayout>
