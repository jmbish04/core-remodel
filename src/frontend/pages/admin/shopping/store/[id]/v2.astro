---
/**
 * TEMPORARY V2 preview route — /admin/shopping/store/:id/v2.
 *
 * Renders the work-in-progress viewport overhaul (StoreViewportAppV2) so Justin
 * can touch it live and iterate before it overwrites the production viewport.
 * The original /admin/shopping/store/:id (StoreViewportApp) is untouched. This
 * route + StoreViewportAppV2.tsx retire once the overhaul is promoted.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { StoreViewportAppV2 } from "@/components/showroom/StoreViewportAppV2";

const { id } = Astro.params;
const storeId = id ? Number.parseInt(id, 10) : NaN;
if (!Number.isFinite(storeId)) {
  return Astro.redirect("/admin/shopping/showrooms");
}
---

<BaseLayout
  title="Showroom v2 (preview) — The Monolith"
  description="Work-in-progress viewport overhaul — location, hours, products carried, research."
>
  <StoreViewportAppV2 client:only="react" id={storeId} />
</BaseLayout>
