---
/**
 * /admin/shopping/store/:id/inbox — full-page showroom inbox.
 *
 * Maximises room for the inbox: no page title/description (only a small "back to
 * showroom" link), and the nav rail auto-collapses for this page via BaseLayout's
 * `collapseSidebar` (per-render only — the user's sidebar cookie is untouched).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { StoreInboxApp } from "@/components/gmail/StoreInboxApp";

const { id } = Astro.params;
const storeId = id ? Number.parseInt(id, 10) : NaN;
if (!Number.isFinite(storeId)) {
  return Astro.redirect("/admin/shopping/showrooms");
}
---

<BaseLayout
  title="Showroom Inbox — The Monolith"
  description="Full-page inbox scoped to a single showroom's email correspondence."
  collapseSidebar={true}
>
  <main class="w-full px-4 py-4 md:px-6">
    <a
      href={`/admin/shopping/store/${storeId}`}
      class="mb-3 inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-muted-foreground hover:text-foreground"
    >
      ← Back to showroom
    </a>
    <StoreInboxApp client:only="react" storeId={storeId} />
  </main>
</BaseLayout>
