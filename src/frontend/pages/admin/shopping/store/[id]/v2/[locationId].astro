---
/**
 * TEMPORARY V2 per-location route — /admin/shopping/store/:id/v2/:locationId.
 *
 * The location-centric viewport scoped to one physical site. The bare
 * /admin/shopping/store/:id/v2 renders the primary site; this route renders a
 * specific location. Both mount StoreViewportAppV2. Retires (dropping the /v2
 * segment) when the overhaul is promoted.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { StoreViewportAppV2 } from "@/components/showroom/StoreViewportAppV2";

const { id, locationId } = Astro.params;
const storeId = id ? Number.parseInt(id, 10) : NaN;
const locId = locationId ? Number.parseInt(locationId, 10) : NaN;
if (!Number.isFinite(storeId)) {
  return Astro.redirect("/admin/shopping/showrooms");
}
// A non-numeric locationId falls back to the primary (undefined prop).
const locationProp = Number.isFinite(locId) ? locId : undefined;
---

<BaseLayout
  title="Showroom v2 (preview) — The Monolith"
  description="Work-in-progress viewport overhaul — location, hours, products carried, research."
>
  <StoreViewportAppV2 client:only="react" id={storeId} locationId={locationProp} />
</BaseLayout>
