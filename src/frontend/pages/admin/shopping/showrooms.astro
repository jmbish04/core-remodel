---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ShowroomsDirectoryApp } from "@/components/showroom/ShowroomsDirectoryApp";

// Bare /admin/shopping/showrooms defaults to the map tab. The island rewrites
// the URL to /admin/shopping/showrooms/map on first tab interaction.
---

<BaseLayout
  title="Showrooms — The Monolith"
  description="Bay Area showroom directory with a hub map, filters, and grouped list/directory views."
>
  <ShowroomsDirectoryApp client:only="react" initialTab="map" />
</BaseLayout>
