---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ShowroomsDirectoryApp } from "@/components/showroom/ShowroomsDirectoryApp";

type Tab = "grouped" | "map";
const VALID: Tab[] = ["grouped", "map"];

const raw = Astro.params.tab;
const tab: Tab = VALID.includes(raw as Tab) ? (raw as Tab) : "grouped";

// Normalize unknown segments (incl. the retired list/directory tabs) to the
// grouped default so the URL always matches state.
if (!VALID.includes(raw as Tab)) {
  return Astro.redirect("/admin/shopping/showrooms/grouped");
}

const TAB_LABEL: Record<Tab, string> = {
  grouped: "Grouped",
  map: "Map",
};
---

<BaseLayout
  title={`Showrooms · ${TAB_LABEL[tab]} — The Monolith`}
  description="Bay Area showroom directory: region tabs, live grouped tables, and a hub map."
>
  <ShowroomsDirectoryApp client:only="react" initialTab={tab} />
</BaseLayout>
