---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FinderDetailApp } from "@/components/finder/FinderDetailApp";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/shopping/showrooms/finder");
---

<BaseLayout
  title="Discovery search — The Monolith"
  description="Live results for a showroom discovery search."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <a
        href="/admin/shopping/showrooms/finder"
        class="mb-3 inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        All searches
      </a>
      <h1 class="mb-2 flex items-center gap-2 text-3xl font-bold tracking-tight">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6 text-muted-foreground"
          aria-hidden="true"
        >
          <path d="m21 21-4.34-4.34"></path>
          <circle cx="11" cy="11" r="8"></circle>
        </svg>
        Discovery results
      </h1>
      <p class="text-muted-foreground">
        Live results, ranked by AI. Add a place to your directory, or mark it
        not-interested so it never resurfaces.
      </p>
    </div>
    <FinderDetailApp client:only="react" slug={slug} />
  </main>
</BaseLayout>
