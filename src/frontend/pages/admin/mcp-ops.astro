---
/**
 * @fileoverview 0017 — MCP Ops admin page.
 *
 * Thin Astro shell (matching `admin/config.astro`) that mounts the
 * `<McpOpsApp />` React island. The island renders KPI cards + a 4-tab
 * observability view (sessions/transcripts, conversations, bugs, features)
 * over the admin-gated `/api/mcp-ops/*` JSON endpoints.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { McpOpsApp } from "@/components/McpOpsApp";
---

<BaseLayout
  title="MCP Ops - 126 Colby - Remodel Mission Control"
  description="Operational observability for the MCP server: sessions, transcripts, conversations, bugs, and feature requests."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 flex items-center gap-2 text-3xl font-bold tracking-tight">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6 text-muted-foreground"
          aria-hidden="true"
        >
          <path d="M12 8V4H8"></path>
          <rect width="16" height="12" x="4" y="8" rx="2"></rect>
          <path d="M2 14h2"></path>
          <path d="M20 14h2"></path>
          <path d="M15 13v2"></path>
          <path d="M9 13v2"></path>
        </svg>
        MCP Ops
      </h1>
      <p class="text-muted-foreground">
        Live observability for the Model Context Protocol server — session
        transcripts, saved conversations, bug reports, and feature requests.
      </p>
    </div>

    <McpOpsApp initialTab="sessions" client:only="react" />
  </main>
</BaseLayout>
