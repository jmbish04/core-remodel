---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GapPanel } from "@/components/showroom/GapPanel";
---

<BaseLayout
  title="Coverage Gaps — The Monolith"
  description="Product areas your materials list implies but no tracked showroom covers yet."
>
  <main class="container mx-auto max-w-4xl px-4 py-10">
    <div class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight">Coverage Gaps</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Product areas with no showroom coverage yet. Analyze to scan your materials list,
        then dismiss or queue deep research on the gaps that matter.
      </p>
    </div>
    <GapPanel client:only="react" context="showroom" />
  </main>
</BaseLayout>
