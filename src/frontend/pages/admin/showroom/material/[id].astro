---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MaterialViewportApp } from "@/components/showroom/MaterialViewportApp";

const { id } = Astro.params;
const materialId = id ? Number.parseInt(id, 10) : NaN;
if (!Number.isFinite(materialId)) {
  return Astro.redirect("/admin/showroom/schedule");
}
---

<BaseLayout
  title={`Material ${materialId} — The Monolith`}
  description="Single material viewport: required specs, matching products, and purchase link."
>
  <MaterialViewportApp client:only="react" id={materialId} />
</BaseLayout>
