---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminConfigApp } from "@/components/AdminConfigApp";
---

<BaseLayout
  title="Admin Config - 126 Colby - Remodel Mission Control"
  description="System configuration for Permits Intelligence and other pipelines."
>
  <main className="container mx-auto px-4 py-8 pb-12">
    <div className="mb-8">
      <h1 className="mb-2 text-3xl font-bold">System Configuration</h1>
      <p className="text-muted-foreground">
        Manage project variables, intelligence targets, and pipeline settings.
      </p>
    </div>

    <AdminConfigApp client:only="react" />
  </main>
</BaseLayout>
