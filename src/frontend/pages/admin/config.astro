---
/**
 * @fileoverview Configuration home — `/admin/config`.
 *
 * The single entry point to the config area (opened in its own tab via the header
 * cog). Renders `<ConfigHomeApp>`, which outlines every configuration area inside
 * the dedicated config sidebar (ConfigShell). Individual vocabularies live at
 * `/admin/config/<group>/<name>`.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ConfigHomeApp } from "@/components/config/ConfigHomeApp";
---

<BaseLayout
  title="Configuration — 126 Colby"
  description="System configuration hub — property, device, and photo/product vocabularies."
>
  <ConfigHomeApp client:only="react" />
</BaseLayout>
