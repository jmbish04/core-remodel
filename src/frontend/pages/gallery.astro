---
import { FloorplanGalleryApp } from "@/components/FloorplanGalleryApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Gallery - 126 Colby - Remodel Mission Control"
  description="Floorplan-first listing gallery with room-level photo groups."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Image Gallery</h1>
      <p class="text-muted-foreground">
        Start from the floorplan, click room dots, and review mapped listing photos by room.
      </p>
    </div>

    <FloorplanGalleryApp client:only="react" />
  </main>
</BaseLayout>
