---
import { AdminDashboardApp } from "@/components/AdminDashboardApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Admin - 126 Colby - Remodel Mission Control"
  description="Visitor analytics and contractor engagement telemetry."
>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-bold">Admin Analytics</h1>
      <p class="mt-2 text-sm text-muted-foreground">
        View visitor telemetry, page behavior, and recent project activity.
      </p>
    </div>

    <AdminDashboardApp client:only="react" />
  </main>
</BaseLayout>
