---
import { FloorplanGalleryApp } from "@/components/FloorplanGalleryApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Floor Plan - 126 Colby - Remodel Mission Control"
  description="Floorplan-first room portal for listing and inspiration media."
>
  <main class="container mx-auto px-4 py-8 pb-12">
    <div class="mb-8">
      <h1 class="mb-2 text-3xl font-bold">Floor Plan View</h1>
      <p class="text-muted-foreground">
        Start from the plan, open a room, and review listing plus inspiration context together.
      </p>
    </div>

    <FloorplanGalleryApp client:only="react" />
  </main>
</BaseLayout>
