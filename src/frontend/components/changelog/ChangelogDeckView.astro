---
/**
 * Slide deck viewport for one changelog entry — shared by
 * /admin/changelog/[slug]/slides and /admin/changelog/preview/[slug]/slides.
 *
 * Reads the same row the detail page reads (via `loadEntry`, so the D1-then-seed
 * fallback lives in exactly one place) and hands it to the deck island. The deck
 * is `client:only` because it is entirely interactive — keyboard navigation, a
 * slide index, mermaid rendering — and a server pass would only emit the first
 * slide before hydration replaced it.
 */
import { drizzle } from "drizzle-orm/d1";

import { ChangelogDeck } from "@/components/changelog/ChangelogDeck";
import { detailHref, loadEntry, type ChangelogStage } from "@/lib/changelog-blocks";
import { getProposal } from "@backend/services/changelog-proposals";


interface Props {
  slug: string;
  stage: ChangelogStage;
}

/**
 * Pull ```mermaid fenced blocks out of a proposal's markdown so the deck shows
 * them as DIAGRAM slides instead of dumping prose onto centered text slides. The
 * title is the nearest preceding markdown heading (else "Diagram N").
 */
function extractMermaidSlides(markdown: string | null | undefined): { title: string; code: string }[] {
  if (!markdown) return [];
  const out: { title: string; code: string }[] = [];
  let heading = "";
  let inFence = false;
  let buf: string[] = [];
  let n = 0;
  for (const line of markdown.split("\n")) {
    const fence = line.match(/^```(\w*)/);
    if (!inFence && fence) {
      if (fence[1] === "mermaid") { inFence = true; buf = []; }
      continue;
    }
    if (inFence && /^```/.test(line)) {
      n += 1;
      out.push({ title: heading || `Diagram ${n}`, code: buf.join("\n") });
      inFence = false;
      continue;
    }
    if (inFence) { buf.push(line); continue; }
    const h = line.match(/^#{1,4}\s+(.*)/);
    if (h) heading = h[1].replace(/[*`]/g, "").trim();
  }
  return out;
}

const { slug, stage } = Astro.props;
const { entry, detail, prNumber, prUrl } = await loadEntry(Astro.locals.runtime?.env, slug);
const href = detailHref(slug, stage);

// A PROPOSAL's rich diagrams live in the bundle's prd/design markdown, not in
// detail.diagrams — mine them out so the deck is visual, not a wall of text.
let proposalDiagrams: { title: string; code: string }[] = [];
if (stage === "staged") {
  try {
    const env = Astro.locals.runtime?.env;
    if (env?.DB) {
      const found = await getProposal(drizzle(env.DB), slug);
      if (found) {
        proposalDiagrams = [
          ...extractMermaidSlides(found.proposal.prdMarkdown),
          ...extractMermaidSlides(found.proposal.designBriefMarkdown),
        ];
      }
    }
  } catch {
    proposalDiagrams = [];
  }
}

// Same rule the detail page uses: prefer the verification block's per-tag remote
// state, and never imply "applied" for a tag nobody recorded.
const migrations =
  detail?.verification?.migrations?.map((m) => ({ tag: m.tag, appliedRemote: m.appliedRemote })) ??
  (entry?.migrations ?? []).map((tag) => ({ tag, appliedRemote: false }));

const diagrams = [
  ...(detail?.diagrams ?? []).map((d) => ({
    title: d.title ?? d.caption,
    description: d.description,
    code: d.code,
  })),
  // Proposal diagrams (from prd/design markdown) — deduped by code against any
  // already present in detail.diagrams.
  ...proposalDiagrams.filter(
    (p) => !(detail?.diagrams ?? []).some((d) => d.code.trim() === p.code.trim()),
  ),
];
---

{
  entry ? (
    <ChangelogDeck
      client:only="react"
      entryNo={entry.entryNo}
      title={entry.title}
      subtitle={detail?.subtitle}
      summary={entry.summary}
      date={entry.date}
      branch={detail?.branch ?? entry.branch}
      status={entry.status}
      prNumber={prNumber}
      prUrl={prUrl}
      detailHref={href}
      introduction={detail?.introduction}
      problem={detail?.problem}
      approach={detail?.approach}
      diagrams={diagrams}
      apiChanges={detail?.apiChanges ?? []}
      migrations={migrations}
      verification={
        detail?.verification
          ? { command: detail.verification.command, ranAt: detail.verification.ranAt }
          : null
      }
      changes={entry.changes}
    />
  ) : (
    <main class="container mx-auto max-w-3xl px-4 py-16">
      <a href={href} class="text-xs text-muted-foreground underline underline-offset-4">
        ← Back
      </a>
      <div class="mt-6 rounded-xl bg-card px-6 py-12 text-center ring-1 ring-border/40">
        <p class="text-sm font-medium">No changelog entry at this slug.</p>
        <p class="mt-1 font-mono text-xs text-muted-foreground">{slug}</p>
      </div>
    </main>
  )
}
