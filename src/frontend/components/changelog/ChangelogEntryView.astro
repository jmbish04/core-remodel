---
/**
 * Changelog entry viewport — shared by /admin/changelog/[slug] (shipped) and
 * /admin/changelog/preview/[slug] (staged/proposed).
 *
 * Reading order, narrow to wide:
 *   1. Title · subtitle · introduction   — orientation, before any detail
 *   2. Problem                            — full width
 *   3. Approach                           — full width, STACKED under problem
 *   4. Diagrams                           — each with its own title + description
 *   5. Developer: API surface · code · migrations · files touched
 *   6. Verification                       — what was run, verbatim
 *   7. Recap (changelog21)                — Features / Fixes / Improvements
 *
 * Problem and Approach are full-width and stacked rather than side by side: they
 * are prose, they are frequently of very different lengths, and a two-column
 * layout forced the longer one into a narrow column while the shorter left half
 * a screen of white space. Reading order also matters here — the approach only
 * makes sense after the problem, and columns invite reading them in parallel.
 *
 * Hydration is per-island and deliberate: mermaid diagrams, the shiki code
 * blocks and the file tree each render in the browser; everything else is static
 * server-rendered markup.
 */
import { Changelog21 } from "../../../components/beste/block/changelog21";
import { MermaidCn } from "@/components/mermaidcn/MermaidCn";
import { ApiEndpoints } from "@/components/changelog/ApiEndpoints";
import { CodeHighlight } from "@/components/changelog/CodeHighlight";
import { FilesTouchedTree } from "@/components/changelog/FilesTouchedTree";
import {
  detailHref,
  loadEntry,
  toRecap,
  type ChangelogStage,
} from "@/lib/changelog-blocks";
import { toMarkdown } from "@/lib/markdown-normalize";
import { MarkdownProse } from "@/components/research/MarkdownProse";

interface Props {
  slug: string;
  stage: ChangelogStage;
}

const { slug, stage } = Astro.props;
const staged = stage === "staged";

// Source of truth is D1; falls back to the bundled seed (AGENTS.md changelog
// rule). `loadEntry` owns that fallback so the deck view cannot drift from it.
const { entry, detail, prNumber, prUrl } = await loadEntry(Astro.locals.runtime?.env, slug);
const notFound = !entry;

// Branch + PR + tests + remote migration status are mandatory on every entry
// (AGENTS.md "Changelog discipline") — they are how a reader answers "is this
// actually live and actually verified?" without leaving the page.
const branchName = detail?.branch ?? entry?.branch;
const verification = detail?.verification;
// Prefer the verification block's per-tag remote state; otherwise list the tags
// the entry declares with their status explicitly UNKNOWN rather than implying
// they are applied.
const migrationStatus =
  verification?.migrations ??
  (entry?.migrations ?? []).map((tag) => ({ tag, appliedRemote: false, note: "Not recorded" }));
const migrationStatusKnown = Boolean(verification?.migrations?.length);

// Long-form fields are MARKDOWN and render through the shared MarkdownProse —
// the same renderer the proposal bundle and the research pages use. It is
// server-rendered here (no client directive): the markup is static, and only a
// ```mermaid fence inside one of these fields would need the client, which is
// what the dedicated Diagrams section below is for.
const introduction = toMarkdown(detail?.introduction);
const problem = toMarkdown(detail?.problem);
const approach = toMarkdown(detail?.approach);

const diagrams = detail?.diagrams ?? [];
const apiChanges = detail?.apiChanges ?? [];
const codeCards = detail?.code ?? [];
const filesTouched = detail?.filesTouched ?? [];
const hasDeveloperSection =
  apiChanges.length > 0 ||
  codeCards.length > 0 ||
  (detail?.migrations?.length ?? 0) > 0 ||
  filesTouched.length > 0;

const recap = entry ? toRecap(entry, stage) : {};
const backHref = staged ? "/admin/changelog/preview" : "/admin/changelog";
const slidesHref = `${detailHref(slug, stage)}/slides`;
// An entry viewed from the wrong stage (e.g. a shipped row under /preview) still
// renders, but we link across so the reader lands on the canonical one.
const crossHref = entry && entry.status !== stage ? detailHref(slug, entry.status) : null;
---

{
  notFound ? (
    <main class="container mx-auto max-w-3xl px-4 py-16">
      <a href={backHref} class="text-xs text-muted-foreground underline underline-offset-4">
        ← Back
      </a>
      <div class="mt-6 rounded-xl bg-card px-6 py-12 text-center ring-1 ring-border/40">
        <p class="text-sm font-medium">No changelog entry at this slug.</p>
        <p class="mt-1 font-mono text-xs text-muted-foreground">{slug}</p>
      </div>
    </main>
  ) : (
    <main class="container mx-auto max-w-5xl px-4 py-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a href={backHref} class="text-xs text-muted-foreground underline underline-offset-4">
          ← {staged ? "All proposed changes" : "All releases"}
        </a>
        {/*
          Slides view. Placed at the top because it is an alternative way to read
          THIS page, not a footnote to it — someone walking a contractor or a
          reviewer through the change wants it before they start scrolling.
        */}
        <a
          href={slidesHref}
          class="inline-flex items-center gap-1.5 rounded-md bg-violet-500/12 px-2.5 py-1 text-xs font-medium text-violet-300 ring-1 ring-violet-500/25 transition-colors hover:bg-violet-500/20"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <path d="M2 3h20v12H2z" />
            <path d="m12 15 4 6" />
            <path d="m12 15-4 6" />
          </svg>
          Present as slides →
        </a>
      </div>

      <header class="mt-4">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class={`rounded-md px-2 py-0.5 text-[11px] font-medium ${
              entry!.status === "shipped"
                ? "bg-emerald-500/12 text-emerald-300"
                : "bg-amber-500/12 text-amber-300"
            }`}
          >
            {entry!.status === "shipped" ? "Shipped" : "Proposed — not yet deployed"}
          </span>
          {entry!.entryNo ? (
            <span class="rounded-md bg-card px-2 py-0.5 font-mono text-[11px] text-muted-foreground ring-1 ring-border/40">
              #{entry!.entryNo}
            </span>
          ) : null}
          {entry!.tag ? (
            <span class="rounded-md bg-card px-2 py-0.5 text-[11px] text-muted-foreground ring-1 ring-border/40">
              {entry!.tag}
            </span>
          ) : null}
          <span class="rounded-md bg-card px-2 py-0.5 font-mono text-[11px] text-muted-foreground ring-1 ring-border/40">
            {branchName}
          </span>
          {prNumber ? (
            <a
              href={prUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md bg-sky-500/12 px-2 py-0.5 font-mono text-[11px] text-sky-300 ring-1 ring-sky-500/25 hover:bg-sky-500/20"
            >
              PR #{prNumber} ↗
            </a>
          ) : (
            <span class="rounded-md bg-card px-2 py-0.5 font-mono text-[11px] text-muted-foreground ring-1 ring-border/40">
              no PR
            </span>
          )}
          <span class="text-[11px] text-muted-foreground">{entry!.date}</span>
        </div>

        <h1 class="mt-3 text-3xl font-semibold tracking-tight">
          {entry!.entryNo ? (
            <span class="mr-2 font-mono text-2xl font-normal text-muted-foreground">
              #{entry!.entryNo}
            </span>
          ) : null}
          {entry!.title}
        </h1>

        {detail?.subtitle ? (
          <p class="mt-1.5 max-w-3xl text-sm italic text-muted-foreground">{detail.subtitle}</p>
        ) : null}

        <p class="mt-2 max-w-3xl text-sm text-muted-foreground">{entry!.summary}</p>

        {crossHref ? (
          <p class="mt-2 text-xs text-muted-foreground">
            This entry is {entry!.status}.{" "}
            <a href={crossHref} class="underline underline-offset-4">
              View it in the {entry!.status === "shipped" ? "changelog" : "preview"} →
            </a>
          </p>
        ) : null}
      </header>

      {introduction ? (
        <section id="introduction" class="mt-8 max-w-3xl scroll-mt-24">
          <MarkdownProse className="text-[15px]" markdown={introduction} />
        </section>
      ) : null}

      {problem ? (
        <section id="problem" class="mt-8 scroll-mt-24">
          <div class="rounded-xl bg-card p-6 ring-1 ring-rose-500/20">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-rose-300">Problem</h2>
            <MarkdownProse className="mt-3 text-sm" markdown={problem} />
          </div>
        </section>
      ) : null}

      {approach ? (
        <section id="approach" class="mt-6 scroll-mt-24">
          <div class="rounded-xl bg-card p-6 ring-1 ring-emerald-500/20">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-emerald-300">
              Approach
            </h2>
            <MarkdownProse className="mt-3 text-sm" markdown={approach} />
          </div>
        </section>
      ) : null}

      {diagrams.length > 0 ? (
        <section id="diagrams" class="mt-10 scroll-mt-24">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
            Diagrams
          </h2>
          <p class="mt-1 text-xs text-muted-foreground">Scroll to zoom, drag to pan.</p>
          <div class="mt-4 space-y-8">
            {
              /*
               * client:load (not client:visible) on purpose. The mermaidcn
               * renderer's pre-hydration state renders the literal text
               * "No diagram code provided" — which is FALSE here (the code is
               * passed as a prop) and is what a reader would see for any diagram
               * still below the fold. Diagrams are the whole point of this page,
               * so we hydrate eagerly rather than flash a wrong message.
               */
            }
            {diagrams.map((d) => (
              <figure class="rounded-xl bg-card p-5 ring-1 ring-border/40">
                <figcaption class="mb-3">
                  <h3 class="text-sm font-medium">{d.title ?? d.caption}</h3>
                  {d.description ? (
                    <MarkdownProse className="mt-1 text-xs" markdown={d.description} />
                  ) : null}
                </figcaption>
                <MermaidCn code={d.code} caption={d.caption} client:load />
              </figure>
            ))}
          </div>
        </section>
      ) : null}

      {hasDeveloperSection ? (
        <section class="mt-12 border-t border-border/40 pt-8">
          <h2 class="text-sm font-semibold tracking-tight">Developer</h2>
          <p class="mt-1 text-xs text-muted-foreground">
            The implementation: API surface, code, migrations and files touched.
          </p>

          {apiChanges.length > 0 ? (
            <div id="api" class="mt-6 scroll-mt-24">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                API surface
              </h3>
              <div class="mt-3">
                <ApiEndpoints changes={apiChanges} />
              </div>
            </div>
          ) : null}

          {codeCards.length > 0 ? (
            <div id="code" class="mt-8 scroll-mt-24">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                Code
              </h3>
              <div class="mt-3 space-y-4">
                {codeCards.map((c) => (
                  <CodeHighlight
                    code={c.code}
                    lang={c.lang}
                    filename={c.title}
                    client:visible
                  />
                ))}
              </div>
            </div>
          ) : null}

          {detail?.migrations && detail.migrations.length > 0 ? (
            <div id="migrations" class="mt-8 scroll-mt-24">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                Migrations
              </h3>
              <div class="mt-3 space-y-4">
                {detail.migrations.map((m) => (
                  <CodeHighlight code={m.sql} lang="sql" filename={m.tag} client:visible />
                ))}
              </div>
            </div>
          ) : null}

          {filesTouched.length > 0 ? (
            <div id="files" class="mt-8 scroll-mt-24">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                Files touched
                <span class="ml-2 font-mono text-[10px] normal-case tracking-normal text-muted-foreground/70">
                  {filesTouched.length}
                </span>
              </h3>
              <div class="mt-3">
                <FilesTouchedTree files={filesTouched} client:load />
              </div>
            </div>
          ) : null}
        </section>
      ) : null}

      {/*
        Verification. Deliberately shows an explicit "not recorded" state rather
        than rendering nothing: an absent section is indistinguishable from a
        change nobody tested, and the reader cannot tell which they are looking at.
      */}
      <section id="verification" class="mt-12 scroll-mt-24 border-t border-border/40 pt-8">
        <h2 class="text-sm font-semibold tracking-tight">Verification</h2>

        {verification ? (
          <div class="mt-4 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <code class="rounded-md bg-card px-2 py-1 font-mono text-[11px] text-muted-foreground ring-1 ring-border/40">
                {verification.qcScript}
              </code>
              <code class="rounded-md bg-emerald-500/10 px-2 py-1 font-mono text-[11px] text-emerald-300 ring-1 ring-emerald-500/25">
                {verification.command}
              </code>
              {verification.ranAt ? (
                <span class="text-[11px] text-muted-foreground">ran {verification.ranAt}</span>
              ) : null}
            </div>

            {verification.source ? (
              <CodeHighlight
                code={verification.source}
                lang="ts"
                filename={verification.qcScript}
                maxHeightClass="max-h-96"
                client:visible
              />
            ) : null}

            <CodeHighlight
              code={verification.output}
              lang="bash"
              filename="output — verbatim"
              maxHeightClass="max-h-96"
              client:visible
            />
          </div>
        ) : (
          <p class="mt-3 rounded-xl bg-rose-500/8 px-4 py-3 text-xs leading-relaxed text-rose-200/90 ring-1 ring-rose-500/25">
            No QC run was recorded for this entry. Nothing here has been verified against the deployed
            worker — treat the change as unproven, not as passing.
          </p>
        )}

        {migrationStatus.length > 0 ? (
          <div class="mt-5">
            <h3 class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
              Remote migration status
            </h3>
            {/*
              Every branch push deploys the worker, but migrations do NOT ride the
              build — so code reaches production before its table exists unless
              someone ran `pnpm run migrate:remote`. "Unknown" is shown as its own
              state because guessing "applied" is exactly the wrong default: the
              failure it hides is a 500 on every endpoint touching the table.
            */}
            <ul class="mt-2 space-y-1.5">
              {migrationStatus.map((m) => (
                <li class="flex flex-wrap items-center gap-2">
                  <span
                    class={`rounded-md px-2 py-0.5 text-[10px] font-medium ${
                      m.appliedRemote
                        ? "bg-emerald-500/12 text-emerald-300"
                        : migrationStatusKnown
                          ? "bg-rose-500/12 text-rose-300"
                          : "bg-amber-500/12 text-amber-300"
                    }`}
                  >
                    {m.appliedRemote ? "applied to remote" : migrationStatusKnown ? "NOT applied" : "unknown"}
                  </span>
                  <code class="font-mono text-[11px] text-muted-foreground">{m.tag}</code>
                  {m.note ? <span class="text-[11px] text-muted-foreground">— {m.note}</span> : null}
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </section>

      <section class="mt-12 border-t border-border/40 pt-8">
        <Changelog21 {...recap} />
      </section>
    </main>
  )
}
