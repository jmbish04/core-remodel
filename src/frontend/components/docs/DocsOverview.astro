---
import { docsAudienceGroups, docsPages } from "@/lib/docs";
---

<main class="container mx-auto px-4 py-8 pb-14">
  <section class="overflow-hidden rounded-[2rem] border border-border/60 bg-card/70 shadow-[0_24px_90px_-48px_rgba(0,0,0,0.7)]">
    <div class="border-b border-border/50 bg-linear-to-br from-primary/12 via-primary/5 to-transparent px-6 py-8 lg:px-10">
      <span class="rounded-full border border-border/60 bg-background/70 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-muted-foreground">
        Frontend Documentation
      </span>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight text-balance lg:text-5xl">
        Remodel Mission Control Documentation
      </h1>
      <p class="mt-4 max-w-4xl text-base leading-7 text-muted-foreground lg:text-lg">
        This documentation suite explains how homeowners and contractors are meant to use the app
        together. The product goal is a single communication portal that carries the remodel from
        first brief through room decisions, estimates, and contract follow-through.
      </p>

      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {docsAudienceGroups.map((group) => (
          <div class="rounded-2xl border border-border/60 bg-background/75 p-5">
            <div class="text-sm font-semibold text-foreground">{group.title}</div>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{group.summary}</p>
            <div class="mt-4 text-xs uppercase tracking-[0.22em] text-muted-foreground">
              {group.pages.length} guides
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-4 px-6 py-8 lg:grid-cols-4 lg:px-10">
      {[
        {
          title: "1. Homeowner sets the brief",
          body: "Define rooms, rough budgets, existing-condition photos, and early inspiration before asking for pricing.",
        },
        {
          title: "2. Contractor reviews room context",
          body: "Use the floorplan, room photos, supporting files, and decision comparisons to understand what is actually being asked.",
        },
        {
          title: "3. Budget and estimates tighten the scope",
          body: "Estimate revisions and room-level budget changes create a more buildable version of the remodel.",
        },
        {
          title: "4. Contracts carry the final decisions forward",
          body: "Contract controls and revision-safe records keep the agreed scope readable after the quote phase.",
        },
      ].map((step) => (
        <div class="rounded-2xl border border-border/50 bg-background/50 p-4">
          <p class="text-sm font-semibold text-foreground">{step.title}</p>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Read by role</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-muted-foreground">
          Start with the pages that match how you use the product. Every guide includes direct links
          into the live app areas it describes.
        </p>
      </div>
      <a
        href="/docs/shared/collaboration-loop"
        class="rounded-full border border-border/60 bg-card px-4 py-2 text-sm font-medium transition hover:border-primary/40 hover:bg-primary/10"
      >
        Read the full collaboration loop
      </a>
    </div>

    <div class="mt-5 grid gap-4 lg:grid-cols-3">
      {docsAudienceGroups.map((group) => (
        <div class="rounded-[1.75rem] border border-border/60 bg-card/70 p-6">
          <div class="text-sm font-semibold uppercase tracking-[0.24em] text-muted-foreground">
            {group.title}
          </div>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{group.summary}</p>
          <div class="mt-5 space-y-3">
            {group.pages.map((page) => (
              <a
                href={page.href}
                class="block rounded-2xl border border-border/50 bg-background/60 p-4 transition hover:border-primary/40 hover:bg-primary/10"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="text-sm font-semibold text-foreground">{page.shortTitle}</div>
                  <span class:list={[
                    "rounded-full border px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em]",
                    page.status === "planned"
                      ? "border-amber-400/30 bg-amber-500/10 text-amber-200"
                      : "border-emerald-400/30 bg-emerald-500/10 text-emerald-200",
                  ]}>
                    {page.status === "planned" ? "Planned" : "Live"}
                  </span>
                </div>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{page.summary}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Feature directory</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-muted-foreground">
        Each card below links to a dedicated guide that explains how the feature fits into the
        remodel workflow for homeowners, contractors, or both.
      </p>
    </div>

    <div class="mt-5 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
      {docsPages.map((page) => (
        <a
          href={page.href}
          class="rounded-[1.6rem] border border-border/60 bg-card/70 p-5 transition hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary/10"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full border border-border/60 bg-background/70 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-muted-foreground">
              {page.audienceLabel}
            </span>
            <span class:list={[
              "rounded-full border px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em]",
              page.status === "planned"
                ? "border-amber-400/30 bg-amber-500/10 text-amber-200"
                : "border-emerald-400/30 bg-emerald-500/10 text-emerald-200",
            ]}>
              {page.status === "planned" ? "Planned" : "Live"}
            </span>
          </div>

          <h3 class="mt-4 text-xl font-semibold tracking-tight text-foreground">{page.title}</h3>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{page.summary}</p>

          <ul class="mt-4 space-y-2 text-sm leading-6 text-foreground/90">
            {page.highlights.map((highlight) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-primary"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>
</main>
