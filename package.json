  },
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 astro build",
    "preview": "wrangler dev",
    "start": "astro dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:seed": "npx wrangler@latest d1 execute DB --remote --file=seed.sql",
    "migrate:local": "pnpm run db:generate && node scripts/d1-migrate.mjs --local",
    "migrate:remote": "node scripts/d1-migrate.mjs --remote",
    "deploy": "pnpm run build && cp .assetsignore dist/.assetsignore && pnpm run migrate:remote && npx wrangler@latest deploy",
    "deploy:preview": "pnpm run build && cp .assetsignore dist/.assetsignore && node scripts/deploy-preview.mjs",
    "cf-typegen": "wrangler types --include-runtime false",
    "secrets:google-photos": "node scripts/google-photos-secrets.mjs",
    "test:throttle": "node scripts/tests/test_throttled_pipeline.mjs",
    "py:batch-ai-photo-edits": "proofs/tight/jason_20260615/upper_level/kitchen/ai_renders/.venv/bin/python scripts/batch_image_edit.py"
  },
