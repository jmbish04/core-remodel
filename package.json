{
  "name": "core-remodel",
  "version": "26.02.24",
  "description": "core-remodel moodboard and project management on cloudflare workers running Astro, Tailwind CSS, and shadcn/ui.",
  "license": "MIT",
  "author": {
    "name": "126colby",
