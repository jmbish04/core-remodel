{
  "name": "core-remodel",
  "version": "26.02.24",
  "description": "core-remodel moodboard and project management on cloudflare workers running Astro, Tailwind CSS, and shadcn/ui.",
  "license": "MIT",
  "author": {
    "name": "126colby",
    "url": "https://github.com/126colby"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmbish04/core-remodel"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "start": "astro dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:seed": "npx wrangler@latest d1 execute DB --remote --file=seed.sql",
    "migrate:local": "pnpm run db:generate && npx wrangler@latest d1 migrations apply DB --local",
    "migrate:remote": "npx wrangler@latest d1 migrations apply DB --remote",
    "deploy": "pnpm run build && cp .assetsignore dist/.assetsignore && pnpm run migrate:remote && npx wrangler@latest deploy",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.176",
    "@assistant-ui/react": "^0.12.28",
    "@assistant-ui/react-ai-sdk": "^1.3.21",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "@base-ui/react": "^1.4.1",
    "@cloudflare/workers-types": "^4.20260503.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/genai": "^2.3.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@scalar/hono-api-reference": "^0.10.13",
    "@tailwindcss/vite": "^4.2.4",
    "agents": "^0.12.3",
    "ai": "^6.0.174",
    "astro": "^5.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.16",
    "kibo-ui": "^1.1.5",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "platejs": "^53.0.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.6.0",
    "slate": "^0.124.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.124.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.24.2",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "wrangler": "^4.87.0"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types",
      "hono": "$hono"
    }
  }
}
