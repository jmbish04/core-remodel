{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types", "./worker-configuration.d.ts", "node"],
    "paths": {
      "@/*": ["src/frontend/*", "src/backend/*"],
      "@frontend/*": ["src/frontend/*"],
      "@backend/*": ["src/backend/*"],
      "@backend/db": ["src/backend/db/schema/index.ts"],
      "@backend/db/*": ["src/backend/db/*"],
      "@backend/ai/*": ["src/backend/ai/*"],
      "@backend/api/*": ["src/backend/api/*"],
      "@backend/services/*": ["src/backend/services/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "worker-configuration.d.ts"]
}
