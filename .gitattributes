# Generated / machine-authored files.
#
# `linguist-generated=true` collapses these in GitHub PR diffs, excludes them
# from language stats, and (critically) keeps automated reviewers — e.g. Gemini
# Code Assist — from ingesting them. The drizzle migration snapshots alone add
# ~16k lines each; bundling them into a review diff previously tripped Gemini's
# size limit and made it error out on the whole PR.

# Drizzle migration metadata + generated SQL — never hand-edited.
drizzle/meta/**        linguist-generated=true
drizzle/*.sql          linguist-generated=true

# Lockfiles — generated by the package manager.
pnpm-lock.yaml         linguist-generated=true
package-lock.json      linguist-generated=true

# Wrangler-generated ambient types.
worker-configuration.d.ts  linguist-generated=true
