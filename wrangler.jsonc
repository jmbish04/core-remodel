{
  "name": "core-remodel",
  "main": "src/_worker.ts",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  // Vendor guest portal (0043): the short, memorable domain vendors/showrooms are
  // pointed to. `custom_domain` provisions the DNS + TLS on the hacolby.app zone.
  // Stripped from preview workers by scripts/deploy-preview.mjs (workers.dev only).
  "routes": [{ "pattern": "remodel.hacolby.app", "custom_domain": true }],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // Cloudflare Images transform binding (env.IMAGES) — used by the Workshop's
  // clipping-extraction crop (docs/0014_ai_photo_workshop) via
  // src/backend/services/render/cf-images.ts. NO sharp/libvips: `.input().transform().output()`.
  "images": {
    "binding": "IMAGES",
    "remote": true,
  },
  // Cloudflare Email Service — outbound send via env.EMAIL.send() and inbound
  // routing via the email() handler (routing rule set up in Dashboard).
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "vars": {
    // Public origin of the deployed Worker. Used to build ABSOLUTE, clickable
    // page URLs in MCP tool responses (e.g. the exact bug/budget/showroom page
    // to open) instead of bare paths. No trailing slash.
    "WORKER_URL": "https://core-remodel.hacolby.workers.dev",
    "AI_GATEWAY_ID": "core-remodel",
    "CLICKUP_LIST_ID": "901714811766",
    // TODO(justin): fill in a Google Programmable Search Engine "cx" id
    // (https://programmablesearchengine.google.com/) to enable Custom Search
    // website discovery in brand-enrichment.ts. Empty string == disabled;
    // falls back to Workers-AI-only discovery.
    "GOOGLE_SEARCH_CX": "",
    // Showroom Scout model selection. The agent loop runs on the OpenAI Agents
    // SDK but the model underneath is swappable via the aisdk() bridge:
    //   SHOWROOM_SCOUT_PROVIDER = "gemini" | "workers-ai"
    // Grounded web search is a SEPARATE, always-Gemini call (Google only allows
    // built-in search alongside custom function tools on Gemini 3, and 2.5 fails
    // silently rather than erroring) — see ai/agents/showroom-scout/model.ts.
    "SHOWROOM_SCOUT_PROVIDER": "gemini",
    "SHOWROOM_SCOUT_MODEL": "gemini-2.5-flash",
    "SHOWROOM_SCOUT_SEARCH_MODEL": "gemini-2.5-flash",
    // Hard cap on grounded searches per run, enforced in the tool (not a prompt
    // request — prose budgets did not hold and runs drifted to 30 searches and
    // published nothing). Past the cap web_search tells the model to publish.
    "SHOWROOM_SCOUT_SEARCH_BUDGET": "12",
  },
  // DO NOT DELETE COMMENTS
  //  wrangler vectorize create core-remodel-research --preset @cf/baai/bge-large-en-v1.5
  // wrangler vectorize create core-remodel-photos --dimensions=1536 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "remodel-embeddings",
      "remote": true,
    },
    {
      "binding": "RESEARCH_INDEX",
      "index_name": "core-remodel-research",
      "remote": true,
    },
    {
      "binding": "PHOTO_INDEX",
      "index_name": "core-remodel-photos",
      "remote": true,
    },    
  ],
  "workflows": [
    {
      "name": "image-processing-workflow",
      "binding": "IMAGE_PROCESSING_WORKFLOW",
      "class_name": "ImageProcessingWorkflow",
    },
    {
      "name": "checklist-rationale-workflow",
      "binding": "CHECKLIST_RATIONALE_WORKFLOW",
      "class_name": "ChecklistRationaleWorkflow",
    },
    {
      "name": "image-batch-processing-workflow",
      "binding": "IMAGE_BATCH_WORKFLOW",
      "class_name": "ImageBatchProcessingWorkflow",
    },
    {
      "name": "showroom-scrape-workflow",
      "binding": "SHOWROOM_SCRAPE_WORKFLOW",
      "class_name": "ShowroomScrapeWorkflow",
    },
    {
      "name": "showroom-onboarding-workflow",
      "binding": "SHOWROOM_ONBOARDING_WORKFLOW",
      "class_name": "ShowroomOnboardingWorkflow",
    },
    {
      "name": "showroom-bulk-intake-workflow",
      "binding": "SHOWROOM_BULK_INTAKE_WORKFLOW",
      "class_name": "ShowroomBulkIntakeWorkflow",
    },
    {
      "name": "brand-research-workflow",
      "binding": "BRAND_RESEARCH_WORKFLOW",
      "class_name": "BrandResearchWorkflow",
    },
    {
      "name": "product-research-workflow",
      "binding": "PRODUCT_RESEARCH_WORKFLOW",
      "class_name": "ProductResearchWorkflow",
    },
    {
      "name": "bucket-intake-workflow",
      "binding": "BUCKET_INTAKE_WORKFLOW",
      "class_name": "BucketIntakeWorkflow",
    },
    {
      "name": "deep-research-job-workflow",
      "binding": "DEEP_RESEARCH_JOB_WORKFLOW",
      "class_name": "DeepResearchJobWorkflow",
    },
    {
      "name": "blank-canvas-batch",
      "binding": "BLANK_CANVAS_WORKFLOW",
      "class_name": "BlankCanvasBatchWorkflow",
    },
  ],
  "triggers": {
    // "15 */4 * * *": Gmail comms hub ingestion (0013 P3-07) — every 4 hours.
    // A dedicated coarse trigger rather than piggybacking the "* * * * *"
    // master tick: the master tick only drives `dispatchDueWorkflows` (fires
    // Workflow bindings off `system_cron_schedules` rows) plus a couple of
    // per-minute self-heal monitors — it has no notion of arbitrary
    // non-Workflow handlers, and Gmail ingestion doesn't need per-minute
    // resolution (Gmail search + full-message fetch + embedding per company
    // is far too heavy to run 1,440x/day). A dedicated cron keeps the ingest
    // job isolated, easy to disable independently, and cheap.
    //
    // "30 13 * * 1": showroom sale/clearance sweep — weekly, Monday. Same
    // reasoning as Gmail: each sale page costs a Browser Rendering call plus an
    // AI extraction, so this must not ride the per-minute tick. Weekly matches
    // how often showrooms actually change a clearance page, and the sweep skips
    // any page whose content hash is unchanged — so a quiet week is cheap.
    // 0 9 * * 1 — weekly provider price refresh (0029). Published list prices
// change without notice; without a refreshed catalog every cost number on
// /admin/system/agents/usage is a guess.
    "crons": ["0 14 * * *", "* * * * *", "15 */4 * * *", "30 13 * * 1", "0 9 * * 1"],
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "93a212c747b849b19a72e4cca1e0e8bc",
      "remote": true,
    },
    {
      "binding": "SESSIONS",
      "id": "af8ca150b4a7480d923be0ed30baae73",
      "remote": true,
    },
    {
      // MCP connector OAuth (0015): @cloudflare/workers-oauth-provider stores
      // clients / grants / access+refresh tokens here. Binding MUST be named
      // OAUTH_KV (the library looks it up by that exact name).
      "binding": "OAUTH_KV",
      "id": "859ea6b96deb4140831a1d09a70ffcd4",
      "remote": true,
    },
    // Ad-hoc agent memories from any endpoint including mcp tools
    // this is intended to provide agents a place to park memories, 
    // notes, works in progress that either don't have a place in d1 yet,
    // d1 is blocked for some reason or outage, etc.
    {
      "binding": "AGENT_ADHOC_MEMORY_KV",
      "id": "d2c2b93046e742b88c24915e63c7f0ad",
      "remote": true,
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-remodel",
      "database_id": "4811af1e-202d-4b96-99e2-d98dc45c597e",
      "migrations_dir": "drizzle",
      "remote": true,
    },
    {
      // Tesla/Tessie hosted Fleet API + Fleet Telemetry (~500ms) sink — isolated
      // from the app DB so high-frequency telemetry writes don't contend with it.
      // Schema: src/backend/db/schema/tesla/*; migrations: drizzle-tesla/
      // (applied by `pnpm run migrate:tesla:remote`, wired into `deploy`).
      "binding": "TESLA_DB",
      "database_name": "core-remodel-tesla-telemetry",
      "database_id": "1e291822-e19d-42b1-86b6-aa047934a3d7",
      "migrations_dir": "drizzle-tesla",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "core-remodel-artifacts",
      "remote": true,
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID"
    },
    {
      "binding": "CLOUDFLARE_IMAGES_STREAM_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_IMAGES_STREAM_TOKEN"
    },
    {
      "binding": "CF_IMAGES_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_IMAGES_STREAM_TOKEN"
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN"
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY"
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN"
    },
    {
      "binding": "CF_BROWSER_RENDER_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_BROWSER_RENDER_TOKEN"
    },
    {
      "binding": "JULES_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "JULES_API_KEY"
    },
    {
      "binding": "GEMINI_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_API_KEY"
    },
    {
      "binding": "ANTHROPIC_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "ANTHROPIC_API_KEY"
    },
    {
      "binding": "FAL_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "FAL_API_KEY"
    },
    {
      "binding": "REPLICATE_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "REPLICATE_API_TOKEN"
    },
    {
      "binding": "GOOGLE_MAPS_API",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_MAPS_API"
    },
    {
      "binding": "GOOGLE_SEARCH_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_SEARCH_API_KEY"
    },
    {
      // Tessie hosted Fleet API bearer token. Read via getTessieToken().
      "binding": "TESSIE_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "TESSIE_API_TOKEN"
    },
    {
      // VIN of the vehicle ("Betsy") Tessie commands are addressed to.
      // Read via getTeslaVin().
      "binding": "TESLA_BETSY_VIN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "TESLA_BETSY_VIN"
    },
    // Tesla webhook/telemetry auth reuses the existing WORKER_API_KEY binding
    // (above) — no dedicated webhook secret.
    {
      // ClickUp task mirror (0009): consumed by RemodelOrchestrator + /api/clickup.
      "binding": "CLICKUP_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLICKUP_TOKEN"
    },
    {
      "binding": "CLICKUP_TEAM_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLICKUP_TEAM_ID"
    },
    {
      // Gmail comms hub (P3-07): service-account DWD. The private key exceeds
      // the secrets-store value limit, so it is SPLIT — concatenate PT_1 + PT_2.
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1"
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2"
    },
    {
      "binding": "GOOGLE_CREDS_SA_CLIENT_EMAIL",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_CLIENT_EMAIL"
    },
    {
      // Google Photos Picker API (0019): 3-legged OAuth client. Populate via
      // `pnpm run secrets:google-photos` (parses the downloaded client-secret JSON).
      "binding": "GOOGLE_PHOTOS_CLIENT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_PHOTOS_CLIENT_ID"
    },
    {
      "binding": "GOOGLE_PHOTOS_CLIENT_SECRET",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_PHOTOS_CLIENT_SECRET"
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENOVATION_AGENT",
        "class_name": "RenovationAgent",
      },
      {
        "name": "BUDGET_AGENT",
        "class_name": "BudgetAgent",
      },
      {
        "name": "ESTIMATE_COLLAB",
        "class_name": "EstimateCollabHub",
      },
      {
        "name": "A2A_V2",
        "class_name": "GAS_A2A",
      },
      {
        "name": "BID_PORTFOLIO_AGENT",
        "class_name": "BidPortfolioAgent",
      },
      {
        "name": "RESEARCH_AGENT",
        "class_name": "ResearchAgent",
      },
      {
        "name": "PERMIT_INTELLIGENCE_AGENT",
        "class_name": "PermitIntelligenceAgent",
      },
      {
        "name": "SHOWROOM_RESEARCH_AGENT",
        "class_name": "ShowroomResearchAgent",
      },
      {
        // 0006 Phase 2C: real-time collaborative floor-plan rooms (one DO per room).
        "name": "FLOORPLAN_SESSION",
        "class_name": "FloorplanSessionDO",
      },
      {
        // 0008 Phase 7: Engine B — self-hosted 6-agent Deep Research loop.
        "name": "DEEP_RESEARCH_AGENT",
        "class_name": "DeepResearchAgent",
      },
      {
        // Showroom Scout: discovery + vetting + same-day route planning.
        // Cloudflare Agents SDK owns durability/streaming; the OpenAI Agents
        // SDK loop runs inside it. One DO per scouting session.
        "name": "SHOWROOM_SCOUT",
        "class_name": "ShowroomScout",
      },
      {
        // ClickUp integration: autonomous project auditor (4h alarm cycle).
        "name": "REMODEL_ORCHESTRATOR",
        "class_name": "RemodelOrchestrator",
      },
      {
        // General-purpose admin chat assistant (Workers AI, multi-model).
        "name": "ADMIN_CHAT_AGENT",
        "class_name": "AdminChatAgent",
      },
      {
        // 0015 MCP connector: McpAgent (agents/mcp) DO backing the OAuth-gated
        // Model Context Protocol server at /api/mcp (+ /mcp/sse). One DO
        // instance per MCP session; tools registered from src/backend/mcp.
        "name": "REMODEL_MCP",
        "class_name": "RemodelMcpAgent",
      },
      {
        // 0023 ING-02: outbound Fleet-Telemetry connector. One singleton DO holds
        // the Tessie WebSocket only while a drive is active in the daytime window;
        // native alarms + circuit breaker bound its cost. Not an Agents-SDK DO.
        "name": "TESLA_STREAM",
        "class_name": "TeslaStreamDO",
      },
      {
        // 0032 D2: discovery-finder realtime fan-out. One DO per search slug
        // (room "search:<slug>") streams status/revision/results to an open
        // finder page. Hibernatable WebSockets; no alarm, no growing storage.
        "name": "DISCOVERY_HUB",
        "class_name": "DiscoveryHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RenovationAgent"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EstimateCollabHub"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MyA2AV2"],
    },
    {
      "tag": "v4",
      "renamed_classes": [
        {
          "from": "MyA2AV2",
          "to": "GAS_A2A",
        },
      ],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["BudgetAgent"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["BidPortfolioAgent"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["ResearchAgent"],
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["PermitIntelligenceAgent"],
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["ShowroomResearchAgent"],
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["FloorplanSessionDO"],
    },
    {
      "tag": "v11",
      "new_sqlite_classes": ["DeepResearchAgent"],
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["RemodelOrchestrator"],
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["AdminChatAgent"],
    },
    {
      // 0015 MCP connector DO (agents/mcp McpAgent).
      "tag": "v14",
      "new_sqlite_classes": ["RemodelMcpAgent"],
    },
    {
      // Showroom Scout session DO.
      "tag": "v15",
      "new_sqlite_classes": ["ShowroomScout"],
    },
    {
      // 0023 Tesla streaming-ingest connector DO.
      "tag": "v16",
      "new_sqlite_classes": ["TeslaStreamDO"],
    },
    {
      // 0032 D2 discovery-finder realtime fan-out DO.
      "tag": "v17",
      "new_sqlite_classes": ["DiscoveryHub"],
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
}
